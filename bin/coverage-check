#!/usr/bin/env php
<?php

declare(strict_types=1);

// Fails unless every line of src/ is covered: reads the Clover report PHPUnit wrote (composer coverage).
$file = $argv[1] ?? 'var/coverage.xml';
$xml = @simplexml_load_file($file);
if (false === $xml) {
    fwrite(\STDERR, "No coverage report at {$file}.\n");
    exit(1);
}
$metrics = $xml->project->metrics;
$total = (int) $metrics['statements'];
$covered = (int) $metrics['coveredstatements'];
printf("Lines covered: %d / %d\n", $covered, $total);
exit($covered === $total ? 0 : 1);
