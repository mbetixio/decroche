# Your Décroche instance's settings, for Docker. Copy this file to .env.docker (never committed), put your key in it,
# then: docker compose up -d --build
#
# Required: a Hugging Face token (hf_…, "Make calls to Inference Providers" ticked, huggingface.co/settings/tokens),
# or the key of another OpenAI-compatible provider (then set AI_BASE_URL and the models below).
AI_API_KEY=

# The example company, its team and debriefed calls instead of the onboarding (1), in English or French. The demo
# manager's e-mail and password are printed by: docker compose logs decroche | grep -A1 Manager
DECROCHE_DEMO=0
DECROCHE_LANGUAGE=en

# The address your users open, for the links Décroche generates (call links, invitations). Your domain behind HTTPS
# once deployed; add it to MCP_ALLOWED_HOSTS too, for Claude to connect.
DEFAULT_URI=http://localhost:7077
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: the rest has working defaults (see the README's Configuration).
# AI_BASE_URL=https://router.huggingface.co/v1
# AI_PERSONA_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# AI_COACH_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# AI_WRITER_MODEL=openai/gpt-oss-120b
# AI_LIMIT_CALLS_PER_HOUR=20
# AI_LIMIT_LINES_PER_MINUTE=40
# TRUSTED_PROXIES=private_ranges          your reverse proxy, if it forwards the client's address
# APP_TIMEZONE=Europe/Paris
# SOURCE_URL=https://github.com/you/decroche   your fork, if you modify Décroche (AGPL-3.0)
