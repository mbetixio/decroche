{
    "name": "mbetixio/decroche",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Mathieu Bernard",
            "email": "mbernard@etixio.com",
            "homepage": "https://etixio.com",
            "role": "Author"
        }
    ],
    "description": "Rehearse sales calls out loud against an AI client with a hidden brief, then get graded by a coach. Symfony AI, MCP and Hugging Face.",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "mcp/sdk": "^0.9",
        "nyholm/psr7": "^1.8",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-bundle": "^1.0@beta",
        "symfony/ai-generic-platform": "^1.0@beta",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/dom-crawler": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "^8.1",
        "symfony/flex": "^2",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/mcp-bundle": "^1.0@beta",
        "symfony/monolog-bundle": "^4.1",
        "symfony/process": "8.1.*",
        "symfony/rate-limiter": "^8.1",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/ux-twig-component": "^3.7",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^3.29"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "phpunit",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover var/coverage.xml --coverage-text",
            "@php bin/coverage-check var/coverage.xml"
        ],
        "stan": [
            "@php bin/console cache:warmup --env=dev",
            "phpstan analyse --memory-limit=1G"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff",
        "lint": [
            "@php bin/console lint:container",
            "@php bin/console lint:yaml config translations",
            "@php bin/console lint:twig templates",
            "@php bin/console doctrine:schema:validate --skip-sync"
        ],
        "check": [
            "@lint",
            "@cs",
            "@stan",
            "@coverage"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "8.1.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/phpunit-bridge": "^8.1"
    },
    "scripts-descriptions": {
        "test": "Runs the test suite (offline, random order).",
        "coverage": "Runs the suite with coverage and fails below 100 % of the lines.",
        "stan": "PHPStan at level max.",
        "cs": "Checks the coding standard.",
        "lint": "Lints the container, YAML, Twig and the Doctrine mapping.",
        "check": "Everything CI runs."
    }
}
