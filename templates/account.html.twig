{% extends 'base.html.twig' %}
{% block title %}Mon compte{% endblock %}
{% block body %}
<div class="head"><h1>Mon compte</h1></div>
<div class="cols2">
  <div class="card stack">
    <h2>🤖 M'entraîner depuis Claude ou ChatGPT</h2>
    <p>Sparring est aussi un serveur MCP : ajoutez-le comme connecteur à votre IA et entraînez-vous depuis la conversation (« lance-moi un sparring sur un DAF pressé »). Le débrief s'affiche en MCP App.</p>
    {% if key %}
      <div class="flash">Voici votre adresse personnelle. Copiez-la maintenant : elle ne sera plus affichée.</div>
      <input readonly value="{{ mcp }}?key={{ key }}" onclick="this.select()" style="font-family:monospace;font-size:13px">
      <p class="small muted">Dans Claude : Paramètres › Connecteurs › Ajouter un connecteur personnalisé, puis collez l'adresse. Elle vaut mot de passe : ne la partagez pas.</p>
    {% else %}
      <p class="small muted">{{ app.user.mcpKeyHash ? 'Vous avez déjà une clé. En créer une nouvelle désactive l\'ancienne.' : 'Créez votre clé personnelle pour obtenir votre adresse.' }}</p>
    {% endif %}
    <form method="post"><input type="hidden" name="_token" value="{{ csrf_token('account') }}"><button class="btn dark" name="mcp" value="1">{{ app.user.mcpKeyHash ? 'Créer une nouvelle clé' : 'Créer ma clé MCP' }}</button></form>
  </div>
  <form method="post" class="card stack">
    <h2>Mot de passe</h2>
    <input type="hidden" name="_token" value="{{ csrf_token('account') }}">
    <div><label>Mot de passe actuel</label><input type="password" name="current" required autocomplete="current-password"></div>
    <div><label>Nouveau mot de passe</label><input type="password" name="password" required minlength="8" autocomplete="new-password"></div>
    <div><button class="btn">Changer le mot de passe</button></div>
    <p class="small muted">Connecté en tant que {{ app.user.email }} · {{ app.user.manager ? 'manager' : 'commercial' }}</p>
  </form>
</div>
{% endblock %}
