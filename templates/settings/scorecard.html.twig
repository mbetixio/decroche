{# The scorecard the coach grades every call against. #}
{% extends 'base.html.twig' %}
{% block title %}{{ 'settings.title'|trans }}{% endblock %}
{% block body %}
{{ include('settings/_tabs.html.twig') }}
{{ form_start(form, {attr: {class: 'stack'}}) }}
