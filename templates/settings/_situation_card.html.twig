{# One situation of the catalogue: the essentials at a glance, the details to unfold. #}
{% set data = situation.vars.data %}
<div class="card situation-card">
    <span class="emoji">{{ data.emoji ?? '📞' }}</span>
    <details {{ situation.vars.valid ? '' : 'open' }}>
        <summary>
            <b>{{ data.label ?? '' }}</b>
            <div class="row small muted" style="margin-top:4px">
                {% if data %}<span class="badge">{{ data.family|trans }}</span><span class="badge {{ data.direction.value == 'incoming' ? 'accent' : 'brand' }}"><twig:Icon :name="data.direction.value == 'incoming' ? 'phone-incoming' : 'phone-outgoing'" />{{ data.direction|trans }}</span>{% endif %}
                <span>{{ 'settings.situations.edit'|trans }}</span>
            </div>
            {% if data and data.pitch %}<p class="small muted" style="margin-top:8px">{{ data.pitch|length > 180 ? data.pitch|slice(0, 180) ~ '…' : data.pitch }}</p>{% endif %}
        </summary>
        <div class="stack" style="--gap:12px;margin-top:14px">
            {{ form_widget(situation.key) }}
            <div class="cols-2">{{ form_row(situation.label) }}{{ form_row(situation.emoji) }}</div>
            <div class="cols-2">{{ form_row(situation.family) }}{{ form_row(situation.direction) }}</div>
            {{ form_row(situation.material) }}
            {{ form_row(situation.pitch) }}
            {{ form_row(situation.objectives) }}
        </div>
    </details>
    {{ form_widget(situation.keep, {attr: {title: 'form.situation.keep'|trans, 'data-remove': 'false', class: 'keep-toggle'}}) }}
</div>
