{# The company settings' header and tabs. #}
<header class="page-head">
    <div class="page-head-text"><h1>{{ 'settings.title'|trans }}</h1><p class="lead">{{ 'settings.lead'|trans }}</p></div>
</header>
<nav class="tabs" aria-label="{{ 'settings.title'|trans }}">
    <a href="{{ path('settings') }}" {{ tab == 'company' ? 'aria-current="page"' }}>{{ 'settings.tab.company'|trans }}</a>
    <a href="{{ path('settings_situations') }}" {{ tab == 'situations' ? 'aria-current="page"' }}>{{ 'settings.tab.situations'|trans }}</a>
    <a href="{{ path('settings_scorecard') }}" {{ tab == 'scorecard' ? 'aria-current="page"' }}>{{ 'settings.tab.scorecard'|trans }}</a>
</nav>
