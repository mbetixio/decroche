{# A member's figures: for themself, and for their managers. stats: Stats; recent: their last calls; mine: their own. #}
{% set level = stats.level %}
<div class="stats">
    <twig:Stat icon="award" :label="'progress.level'|trans" :value="level.number" :suffix="level.name|trans" />
    <twig:Stat icon="phone" :label="'progress.calls'|trans" :value="stats.done" :suffix="stats.abandoned ? 'progress.abandoned'|trans({'%count%': stats.abandoned}) : null" />
    <twig:Stat icon="chart" :label="'progress.average'|trans" :value="stats.average ?? '—'" :suffix="stats.trend is not null ? (stats.trend >= 0 ? '+' : '') ~ stats.trend ~ ' ' ~ 'progress.trend'|trans : null" />
    <twig:Stat icon="target" :label="'progress.goals'|trans" :value="stats.goalRate is not null ? stats.goalRate ~ ' %' : '—'" />
    <twig:Stat icon="key" :label="'progress.discovery'|trans" :value="stats.discovery is not null ? stats.discovery ~ ' %' : '—'" />
    <twig:Stat icon="flame" :label="'progress.streak'|trans" :value="stats.streak" :suffix="'progress.days'|trans" />
</div>

<div class="cols-2" style="margin-top:20px">
    <section class="card">
        <div class="card-head"><h2><twig:Icon name="chart" />{{ 'progress.scores'|trans }}</h2></div>
        {% if stats.scores|length > 1 %}
            {% set n = stats.scores|length %}
            {% set points = [] %}
            {% for s in stats.scores %}{% set points = points|merge([(loop.index0 * 600 / (n - 1))|round ~ ',' ~ (180 - s.score * 1.6)|round]) %}{% endfor %}
            <svg viewBox="-10 0 620 190" role="img" aria-label="{{ 'progress.scores'|trans }}" style="width:100%;height:auto;overflow:visible">
                {% for y in [20, 100, 180] %}<line x1="0" x2="600" y1="{{ y }}" y2="{{ y }}" stroke="var(--line)" />{% endfor %}
                <polyline points="{{ points|join(' ') }}" fill="none" stroke="var(--brand)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
                {% for s in stats.scores %}<a href="{{ s.id ? path('call_show', {id: s.id}) : '#' }}"><circle cx="{{ (loop.index0 * 600 / (n - 1))|round }}" cy="{{ (180 - s.score * 1.6)|round }}" r="5" fill="var(--surface)" stroke="var(--brand)" stroke-width="2.5"><title>{{ s.title }} · {{ s.score }}</title></circle></a>{% endfor %}
            </svg>
        {% else %}
            <twig:Empty icon="chart" :title="'progress.no_scores'|trans" />
        {% endif %}
    </section>
    <section class="card">
        <div class="card-head"><h2><twig:Icon name="award" />{{ 'progress.criteria'|trans }}</h2></div>
        {% for key, criterion in stats.criteria %}
            <div class="criterion">
                <b>{{ criterion.label }}{% if key == stats.strongest %} <span class="badge good">{{ 'progress.strongest'|trans }}</span>{% elseif key == stats.weakest %} <span class="badge warn">{{ 'progress.weakest'|trans }}</span>{% endif %}</b>
                <span class="score">{{ criterion.average is not null ? criterion.average|number_format(1) : '—' }}</span>
                <div class="bar"><i style="width: {{ (criterion.average ?? 0) * 10 }}%"></i></div>
            </div>
        {% endfor %}
    </section>
</div>

{% if stats.bySituation %}
    <section class="card flush" style="margin-top:20px">
        <div class="card-head" style="padding:18px 20px 0"><h2><twig:Icon name="sparkles" />{{ 'progress.by_situation'|trans }}</h2></div>
        <div class="table-wrap"><table>
            <thead><tr><th>{{ 'progress.situation'|trans }}</th><th>{{ 'progress.calls'|trans }}</th><th>{{ 'progress.average'|trans }}</th><th>{{ 'progress.goals'|trans }}</th></tr></thead>
            <tbody>{% for row in stats.bySituation %}<tr><td>{{ row.emoji }} {{ row.label }}</td><td>{{ row.calls }}</td><td><twig:Score :value="row.average" /></td><td>{{ row.goals }}</td></tr>{% endfor %}</tbody>
        </table></div>
    </section>
{% endif %}

<section class="card flush" style="margin-top:20px">
    <div class="card-head" style="padding:18px 20px 0"><h2><twig:Icon name="clock" />{{ 'play.recent'|trans }}</h2></div>
    {% if recent %}
        <div class="table-wrap"><table>
            <thead><tr><th>{{ 'progress.date'|trans }}</th><th>{{ 'progress.call'|trans }}</th><th>{{ 'progress.status'|trans }}</th><th>{{ 'progress.score'|trans }}</th></tr></thead>
            <tbody>{% for call in recent %}<tr><td class="nowrap small">{{ call.startedAt|moment }}</td><td><a href="{{ path('call_show', {id: call.id}) }}">{{ call.scenario.title }}</a></td><td><twig:Status :call="call" /></td><td><twig:Score :value="call.score" /></td></tr>{% endfor %}</tbody>
        </table></div>
    {% else %}
        <twig:Empty icon="phone" :title="'play.no_calls'|trans" />
    {% endif %}
</section>
