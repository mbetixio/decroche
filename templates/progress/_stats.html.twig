{# A member's figures: for themself, and for their managers. stats: Stats; recent: their last calls; mine: their own. #}
{% set level = stats.level %}
<div class="stats">
    <twig:Stat :label="'progress.level'|trans" :value="level.number" :suffix="level.name|trans" />
    <twig:Stat :label="'progress.calls'|trans" :value="stats.done" :suffix="stats.abandoned ? 'progress.abandoned'|trans({'%count%': stats.abandoned}) : null" />
    <twig:Stat :label="'progress.average'|trans" :value="stats.average ?? '—'" :suffix="stats.trend is not null ? (stats.trend >= 0 ? '+' : '−') ~ stats.trend|abs ~ ' ' ~ 'progress.trend'|trans : null" />
    <twig:Stat :label="'progress.goals'|trans" :value="stats.goalRate is not null ? stats.goalRate ~ ' %' : '—'" />
    <twig:Stat :label="'progress.discovery'|trans" :value="stats.discovery is not null ? stats.discovery ~ ' %' : '—'" />
    <twig:Stat :label="'progress.streak'|trans" :value="stats.streak" :suffix="'progress.days'|trans" />
</div>

<div class="halves section spaced">
    <section aria-labelledby="scores-title">
        <div class="section-head"><h2 id="scores-title">{{ ((mine ?? true) ? 'progress.scores' : 'progress.scores_member')|trans }}</h2></div>
        {% if stats.scores|length > 1 %}
            {% set n = stats.scores|length %}
            {% set points = [] %}
            {% for s in stats.scores %}{% set points = points|merge([(loop.index0 * 600 / (n - 1))|round ~ ',' ~ (180 - s.score * 1.6)|round]) %}{% endfor %}
            <svg class="chart" viewBox="-30 0 640 190" role="img" aria-label="{{ 'progress.scores_aria'|trans({'%count%': n, '%last%': (stats.scores|last).score}) }}">
                {% for y in [20, 100, 180] %}<line x1="0" x2="600" y1="{{ y }}" y2="{{ y }}" /><text x="-8" y="{{ y + 4 }}" text-anchor="end">{{ ((180 - y) / 1.6)|round }}</text>{% endfor %}
                <polyline points="{{ points|join(' ') }}" />
                {% for s in stats.scores %}<a href="{{ s.id ? path('call_show', {id: s.id}) : '#' }}"><circle cx="{{ (loop.index0 * 600 / (n - 1))|round }}" cy="{{ (180 - s.score * 1.6)|round }}" r="5"><title>{{ s.title }} · {{ s.score }}</title></circle></a>{% endfor %}
            </svg>
        {% else %}
            <twig:Empty :title="'progress.no_scores'|trans" />
        {% endif %}
    </section>
    <section aria-labelledby="by-criterion-title">
        <div class="section-head"><h2 id="by-criterion-title">{{ 'progress.criteria'|trans }}</h2></div>
        <div class="criteria">
            {% for key, criterion in stats.criteria %}
                <div class="criterion">
                    <b>{{ criterion.label }}{% if key == stats.strongest %} <span class="tag good">{{ 'progress.strongest'|trans }}</span>{% elseif key == stats.weakest %} <span class="tag warn">{{ 'progress.weakest'|trans }}</span>{% endif %}</b>
                    <span class="score">{{ criterion.average is not null ? criterion.average|number_format(1) : '—' }}</span>
                    <div class="bar" aria-hidden="true"><i style="--pct: {{ (criterion.average ?? 0) * 10 }}%"></i></div>
                </div>
            {% endfor %}
        </div>
    </section>
</div>

{% if stats.bySituation %}
    <section class="section spaced" aria-labelledby="by-situation-title">
        <div class="section-head"><h2 id="by-situation-title">{{ 'progress.by_situation'|trans }}</h2></div>
        <div class="table-wrap"><table>
            <thead><tr><th scope="col">{{ 'progress.situation'|trans }}</th><th scope="col" class="num">{{ 'progress.calls'|trans }}</th><th scope="col" class="num">{{ 'progress.average'|trans }}</th><th scope="col" class="num">{{ 'progress.goals'|trans }}</th></tr></thead>
            <tbody>{% for row in stats.bySituation %}<tr><td>{{ row.label }}</td><td class="num">{{ row.calls }}</td><td class="num"><twig:Score :value="row.average" /></td><td class="num">{{ row.goals }}</td></tr>{% endfor %}</tbody>
        </table></div>
    </section>
{% endif %}

<section class="section spaced" aria-labelledby="latest-title">
    <div class="section-head">
        <h2 id="latest-title">{{ ((mine ?? true) ? 'play.recent' : 'progress.recent_member')|trans }}</h2>
        {% if (mine ?? true) and recent %}<a class="section-link" href="{{ path('call_history') }}">{{ 'action.see_all'|trans }}</a>{% endif %}
    </div>
    {% if recent %}
        {{ include('call/_log.html.twig', {calls: recent}) }}
    {% else %}
        <twig:Empty :title="'play.no_calls'|trans" />
    {% endif %}
</section>
