{# The company's offer sheet and catalogue of situations, as the personas know them. #}
{% extends 'base.html.twig' %}
{% block title %}{{ 'nav.offer'|trans }}{% endblock %}
{% block body %}
<header class="page-head">
    <div class="page-head-text"><p class="eyebrow">{{ company.name }}</p><h1>{{ 'offer.title'|trans }}</h1><p class="lead">{{ 'offer.lead'|trans }}</p></div>
    {% if is_granted('ROLE_MANAGER') %}<div class="page-actions"><a class="btn" href="{{ path('settings') }}">{{ 'action.edit'|trans }}</a></div>{% endif %}
</header>
<div class="split">
    <section aria-labelledby="sheet-title">
        <div class="section-head"><h2 id="sheet-title">{{ 'offer.sheet'|trans }}</h2></div>
        <div class="pre measure">{{ company.offer ?: 'offer.none'|trans }}</div>
        {% if company.sectors %}
            <div class="stack stack-s mt-l">
                <h3 class="label">{{ 'form.sectors'|trans }}</h3>
                <p class="muted">{{ company.sectors|join(' · ') }}</p>
            </div>
        {% endif %}
    </section>
    <section aria-labelledby="situations-title">
        <div class="section-head"><h2 id="situations-title">{{ 'offer.situations'|trans }}</h2></div>
        <ul class="list">
            {% for situation in company.situations %}
                <li class="list-item"><span><span class="list-title">{{ situation.label }}</span><span class="list-sub">{{ situation.family|trans }} · {{ situation.direction|trans }}</span></span></li>
            {% endfor %}
        </ul>
    </section>
</div>
{% endblock %}
