{% extends 'base.html.twig' %}
{% block title %}L'offre {{ space.of }}{% endblock %}
{% block body %}
<div class="head"><div><h1>📘 L'offre {{ space.of }}</h1><p class="muted">La fiche que connaissent vos interlocuteurs simulés et que le coach utilise pour vous noter : une promesse qui n'y est pas vous coûte des points.</p></div></div>
<div class="cols2" style="grid-template-columns:2fr 1fr">
  <div class="card offer">{% for block in offer|split("\n\n") %}<p>{{ block|e|replace({"\n": ' '})|replace({'- ': '<br>• '})|raw }}</p>{% endfor %}{% if is_granted('ROLE_MANAGER') %}<p class="small"><a href="{{ path('space') }}">✏️ Corriger la fiche</a></p>{% endif %}</div>
  <div class="card"><h2>Les {{ situations|length }} situations du jeu</h2>
    {% for f, label in constant('App\\Game\\Situations::FAMILIES') %}<h3 style="margin-top:12px">{{ label }}</h3>{% for sit in situations|filter(x => x.family == f) %}<div class="small" style="padding:3px 0">{{ sit.emoji }} {{ sit.label }} <span class="muted">· {{ sit.direction == 'entrant' ? 'on vous appelle' : 'vous appelez' }}</span></div>{% endfor %}{% endfor %}
  </div>
</div>
{% endblock %}
