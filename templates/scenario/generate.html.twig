{% extends 'base.html.twig' %}
{% block title %}Générer un scénario{% endblock %}
{% block body %}
<div class="head"><div><h1>✨ Préparer un rendez-vous</h1><p class="muted">Collez la fiche d'un vrai prospect, ou décrivez la situation : l'IA écrit le persona, le contexte et un brief caché crédible. Vous vous entraînez ensuite contre lui.</p></div></div>
{% if error %}<div class="flash error">{{ error }}</div>{% endif %}
<form method="post" class="card stack" id="gen">
  <input type="hidden" name="_token" value="{{ csrf_token('generate') }}">
  <div class="row"><label class="row" style="font-weight:600"><input type="radio" name="source" value="idea" {{ (v.source ?? 'idea') != 'call' ? 'checked' }} style="width:auto"> Une fiche prospect ou une situation</label>
    <label class="row" style="font-weight:600"><input type="radio" name="source" value="call" {{ (v.source ?? '') == 'call' ? 'checked' }} style="width:auto"> La transcription d'un vrai appel</label></div>
  <p class="small muted" style="margin-top:-8px">Une transcription (Aircall, Ringover, Gong, Teams, Zoom…) recrée le client tel qu'il était : rejouez l'appel et faites mieux.</p>
  <div><label for="idea">La fiche prospect, la situation ou la transcription</label><textarea id="idea" name="idea" rows="9" required placeholder="Ex. : Société Transalp, transporteur frigorifique, 300 salariés, Grenoble. Interlocuteur : Pierre Vidal, DSI depuis 6 mois. Leur TMS maison est maintenu par un prestataire qui ferme. Ont téléchargé notre livre blanc sur les équipes dédiées. Rendez-vous de découverte jeudi.">{{ v.idea ?? '' }}</textarea></div>
  <div class="cols3">
    <div><label>Type de rendez-vous</label><select name="category"><option value="">Au choix de l'IA</option>{% for k, l in constant('App\\Entity\\Scenario::CATEGORIES') %}<option value="{{ k }}" {{ (v.category ?? '') == k ? 'selected' }}>{{ l }}</option>{% endfor %}</select></div>
    <div><label>Difficulté</label><select name="difficulty">{% for k, l in constant('App\\Entity\\Scenario::DIFFICULTIES') %}<option value="{{ k }}" {{ (v.difficulty ?? 2) == k ? 'selected' }}>{{ l }}</option>{% endfor %}</select></div>
    <div><label>Durée (minutes)</label><input type="number" name="minutes" min="3" max="60" value="{{ v.minutes ?? 12 }}"></div>
  </div>
  <p class="small muted">{{ app.user.manager ? 'Le scénario rejoint la bibliothèque de l\'équipe : vous pourrez le relire et le corriger.' : 'Le scénario reste à vous (et à vos managers). Son brief vous est caché : la surprise fait partie de l\'exercice.' }}</p>
  <div><button class="btn primary" id="go">Générer le scénario</button> <span class="muted small" id="wait" hidden>L'IA écrit le scénario, environ 30 secondes…</span></div>
</form>
{% endblock %}
{% block scripts %}<script>document.getElementById('gen').addEventListener('submit', () => { document.getElementById('go').disabled = true; document.getElementById('wait').hidden = false; });</script>{% endblock %}
