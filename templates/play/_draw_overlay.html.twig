{# The waiting screen while a call is drawn and written (shown by the draw controller). #}
<div class="overlay" id="draw-overlay" role="status" aria-live="polite" hidden>
    <div class="overlay-panel">
        <span class="loader" aria-hidden="true"><i></i><i></i><i></i></span>
        <h2>{{ 'play.drawing'|trans }}</h2>
        <p>{{ 'play.drawing_text'|trans }}</p>
    </div>
</div>
