{# Home: the one main action (a new call), where the member stands (the difficulty of their calls, their average and
   trend, what to work on), the missions, the latest calls as a log, what may come up. #}
{% extends 'base.html.twig' %}
{% block title %}{{ 'nav.play'|trans }}{% endblock %}
{% block body %}
<header class="page-head">
    <div class="page-head-text">
        <p class="eyebrow">{{ 'play.hello'|trans({'%name%': app.user.name|split(' ')|first}) }}</p>
        <h1>{{ 'play.title'|trans }}</h1>
    </div>
</header>

{% if current %}
    <div class="current-call">
        <div>
            <span class="tag {{ current.isLive ? 'live' : 'warn' }}">{{ (current.isLive ? 'play.current.live' : 'play.current.debrief')|trans }}</span>
            <p class="list-title">{{ current.scenario.title }}</p>
        </div>
        <a class="btn" href="{{ path('call_show', {id: current.id}) }}">{{ (current.isLive ? 'play.current.resume' : 'play.current.see')|trans }}<twig:Icon name="arrow-right" /></a>
    </div>
{% endif %}

<div class="home-top">
    {{ include('play/_new_call.html.twig') }}
    {% set challenge = stats.challenge %}
    <section class="standing" aria-labelledby="standing-title">
        <h2 id="standing-title" class="standing-title">{{ 'play.standing.title'|trans }}</h2>
        <p class="standing-mode">{{ 'play.standing.mode'|trans }} <b>{{ challenge.difficulty|trans }}</b></p>
        <p class="small muted">
            {%- if challenge.warmingUp -%}
                {{ 'play.standing.warm_up'|trans({'%count%': constant('App\\Progress\\Challenge::WARM_UP')}) }}
            {%- else -%}
                {{ 'play.standing.why'|trans({'%count%': challenge.basis, '%average%': challenge.recentAverage}) }}
                {{ (challenge.difficulty.value == 3 ? 'play.standing.top' : 'play.standing.next')|trans }}
            {%- endif -%}
        </p>
        <div class="stats">
            <twig:Stat :label="'progress.calls'|trans" :value="stats.done" />
            <twig:Stat :label="'progress.average'|trans" :value="stats.average ?? '—'" :suffix="stats.trend is not null ? (stats.trend >= 0 ? '+' : '−') ~ stats.trend|abs ~ ' ' ~ 'progress.trend'|trans : null" />
            <twig:Stat :label="'play.standing.work_on'|trans" :value="stats.weakest ? stats.criteria[stats.weakest].label : '—'" :suffix="stats.weakest ? stats.criteria[stats.weakest].average|number_format(1) ~ ' / 10' : null" />
        </div>
    </section>
</div>

{% if missions %}
    <section class="section spaced" aria-labelledby="missions-title">
        <div class="section-head"><h2 id="missions-title">{{ 'play.missions'|trans }}</h2></div>
        <div class="missions">
            {% for row in missions %}
                {% set mission = row.mission %}
                {% set situation = mission.situation ? situations[mission.situation] ?? null : null %}
                <article class="mission">
                    <div class="row between">
                        <h3 class="mission-title">{{ 'play.mission_calls'|trans({'%count%': mission.calls, '%situation%': situation ? situation.label : 'play.any_situation'|trans}) }}</h3>
                        {% if row.complete %}<span class="tag good">{{ 'play.mission_done'|trans }}</span>{% elseif row.overdue %}<span class="tag bad">{{ 'play.mission_late'|trans }}</span>{% elseif mission.dueAt %}<span class="tag">{{ 'play.mission_due'|trans({'%date%': mission.dueAt|day}) }}</span>{% endif %}
                    </div>
                    <p class="small muted">{{ 'play.mission_target'|trans({'%score%': mission.target}) }}{% if mission.createdBy %} · {{ 'play.mission_from'|trans({'%name%': mission.createdBy.name}) }}{% endif %}</p>
                    {% if mission.note %}<p class="mission-note">“{{ mission.note }}”</p>{% endif %}
                    <div class="mission-progress">
                        <div class="bar {{ row.complete ? 'good' : 'signal' }}"><i style="--pct: {{ min(100, (row.done / mission.calls * 100)|round) }}%"></i></div>
                        <span class="num">{{ row.done }}/{{ mission.calls }}</span>
                        {% if not row.complete %}
                            <twig:DrawForm :situation="mission.situation"><button class="btn sm">{{ 'play.play'|trans }}</button></twig:DrawForm>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>
{% endif %}

<div class="split section spaced">
    <section aria-labelledby="recent-title">
        <div class="section-head">
            <h2 id="recent-title">{{ 'play.recent'|trans }}</h2>
            {% if recent %}<a class="section-link" href="{{ path('call_history') }}">{{ 'action.see_all'|trans }}</a>{% endif %}
        </div>
        {% if recent %}
            {{ include('call/_log.html.twig', {calls: recent}) }}
        {% else %}
            <twig:Empty :title="'play.no_calls'|trans" :text="'play.no_calls_text'|trans" />
        {% endif %}
    </section>
    <section aria-labelledby="situations-title">
        <div class="section-head">
            <h2 id="situations-title">{{ 'play.may_come_up'|trans }}</h2>
            <a class="section-link" href="{{ path('offer') }}">{{ 'nav.offer'|trans }}</a>
        </div>
        <ul class="situations">
            {% for situation in situations|slice(0, 10) %}<li>{{ situation.label }}</li>{% endfor %}
        </ul>
    </section>
</div>
{{ include('play/_draw_overlay.html.twig') }}
{% endblock %}
