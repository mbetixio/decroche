{# The onboarding layout: the steps on the left, the current step on the right (the steps fold away on phones). #}
{% extends 'base.html.twig' %}
{% block title %}{{ step|trans }}{% endblock %}
{% block page %}
{% set steps = enum('App\\Onboarding\\OnboardingStep').cases() %}
<div class="onboarding">
    <aside class="onboarding-aside">
        <div class="brand"><img class="brand-logo" src="/brand/logo.svg" alt="" width="34" height="34"><span>Practicall<small>{{ 'onboarding.tagline'|trans }}</small></span></div>
        <nav aria-label="{{ 'onboarding.steps'|trans }}">
            <ol class="steps">
                {% for s in steps %}
                    <li class="{{ s.index < step.index ? 'done' : (s == step ? 'current') }}" {{ s == step ? 'aria-current="step"' }}>
                        <span class="n" aria-hidden="true">{% if s.index < step.index %}<twig:Icon name="check" />{% else %}{{ loop.index }}{% endif %}</span>
                        {% if company().hasReached(s) and s != step and (not s.public or not app.user) %}<a href="{{ path('onboarding', {step: s.value}) }}">{{ s|trans }}</a>{% else %}<span>{{ s|trans }}</span>{% endif %}
                    </li>
                {% endfor %}
            </ol>
        </nav>
        <blockquote>{{ 'onboarding.quote'|trans }}</blockquote>
    </aside>
    <main class="onboarding-main" id="main">
        {{ include('_flashes.html.twig') }}
        <div class="onboarding-panel">
            <header class="onboarding-head">
                <p class="eyebrow">{{ 'onboarding.step_of'|trans({'%n%': step.index + 1, '%total%': steps|length}) }}</p>
                <h1>{% block heading %}{% endblock %}</h1>
                {% block lead %}{% endblock %}
            </header>
            {% block content %}{% endblock %}
        </div>
    </main>
</div>
{% endblock %}
