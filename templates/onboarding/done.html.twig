{% extends 'onboarding/layout.html.twig' %}
{% block heading %}{{ 'onboarding.done.title'|trans }}{% endblock %}
{% block lead %}<p class="lead">{{ 'onboarding.done.lead'|trans({'%company%': company.name}) }}</p>{% endblock %}
{% block content %}
<div class="stats">
    <twig:Stat :label="'onboarding.done.offer'|trans" :value="company.offer|length > 0 ? '✓' : '—'" />
    <twig:Stat :label="'onboarding.done.situations'|trans" :value="company.situations|length" />
    <twig:Stat :label="'onboarding.done.criteria'|trans" :value="company.scorecard|length" />
</div>
<section class="panel pad-l stack stack-s" aria-labelledby="first-call-title">
    <h2 id="first-call-title">{{ 'onboarding.done.first_call'|trans }}</h2>
    <p class="muted measure">{{ 'onboarding.done.first_call_text'|trans }}</p>
</section>
<form method="post" action="{{ path('onboarding_finish') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('onboarding-finish') }}">
    {{ include('onboarding/_foot.html.twig', {label: 'onboarding.done.go'|trans}) }}
</form>
{% endblock %}
