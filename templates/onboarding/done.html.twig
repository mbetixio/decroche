{% extends 'onboarding/layout.html.twig' %}
{% block heading %}{{ 'onboarding.done.title'|trans }} 🎉{% endblock %}
{% block lead %}<p class="lead">{{ 'onboarding.done.lead'|trans({'%company%': company.name}) }}</p>{% endblock %}
{% block content %}
<div class="stats">
    <twig:Stat icon="file" :label="'onboarding.done.offer'|trans" :value="company.offer|length > 0 ? '✓' : '—'" />
    <twig:Stat icon="phone" :label="'onboarding.done.situations'|trans" :value="company.situations|length" />
    <twig:Stat icon="target" :label="'onboarding.done.criteria'|trans" :value="company.scorecard|length" />
</div>
<div class="card hero pad-l">
    <span class="badge glass"><twig:Icon name="sparkles" />{{ 'onboarding.done.ready'|trans }}</span>
    <h2 style="font-size:26px;margin:12px 0 8px;color:#fff">{{ 'onboarding.done.first_call'|trans }}</h2>
    <p style="color:rgb(255 255 255 / .85);max-width:52ch">{{ 'onboarding.done.first_call_text'|trans }}</p>
</div>
<form method="post" action="{{ path('onboarding_finish') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('onboarding-finish') }}">
    {{ include('onboarding/_foot.html.twig', {actions: '<button class="btn primary lg"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>' ~ 'onboarding.done.go'|trans ~ '</button>'}) }}
</form>
{% endblock %}
