{% extends 'onboarding/layout.html.twig' %}
{% block heading %}{{ 'onboarding.offer.title'|trans }}{% endblock %}
{% block lead %}<p class="lead">{{ 'onboarding.offer.lead'|trans }}</p>{% endblock %}
{% block content %}
{{ form_start(form, {attr: {class: 'form card pad-l'}}) }}
    {{ form_row(form.offer) }}
    {{ form_row(form.sectors) }}
    {{ include('onboarding/_foot.html.twig', {actions: '<button class="btn primary lg">' ~ 'action.continue'|trans ~ ' →</button>'}) }}
{{ form_end(form) }}
{% endblock %}
