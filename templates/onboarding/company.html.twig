{% extends 'onboarding/layout.html.twig' %}
{% block heading %}{{ 'onboarding.company.title'|trans }}{% endblock %}
{% block lead %}<p class="lead">{{ 'onboarding.company.lead'|trans }}</p>{% endblock %}
{% block content %}
{{ form_start(form, {attr: {class: 'form'}}) }}
    {{ form_errors(form) }}
    <div class="fields-2">{{ form_row(form.name) }}{{ form_row(form.website) }}</div>
    {{ form_row(form.about) }}
    <div class="panel tinted row between">
        <div class="grow"><p class="list-title">{{ 'onboarding.company.example_title'|trans }}</p><p class="small muted">{{ 'onboarding.company.example'|trans }}</p></div>
        <button class="btn" name="action" value="example" formnovalidate>{{ 'onboarding.company.example_button'|trans }}</button>
    </div>
    {{ include('onboarding/_foot.html.twig', {label: 'onboarding.company.analyze'|trans, name: 'action', value: 'analyze'}) }}
{{ form_end(form) }}
{% endblock %}
