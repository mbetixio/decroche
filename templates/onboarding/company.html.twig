{% extends 'onboarding/layout.html.twig' %}
{% block heading %}{{ 'onboarding.company.title'|trans }}{% endblock %}
{% block lead %}<p class="lead">{{ 'onboarding.company.lead'|trans }}</p>{% endblock %}
{% block content %}
{{ form_start(form, {attr: {class: 'form card pad-l'}}) }}
    {{ form_errors(form) }}
    <div class="cols-2">{{ form_row(form.name) }}{{ form_row(form.website) }}</div>
    {{ form_row(form.about) }}
    <div class="card" style="background:var(--accent-soft);border:0;padding:16px 18px">
        <div class="row between">
            <div><b>{{ 'onboarding.company.example_title'|trans }}</b><p class="small muted">{{ 'onboarding.company.example'|trans }}</p></div>
            <button class="btn" name="action" value="example" formnovalidate><twig:Icon name="sparkles" />{{ 'onboarding.company.example_button'|trans }}</button>
        </div>
    </div>
    {{ include('onboarding/_foot.html.twig', {actions: '<button class="btn primary lg" name="action" value="analyze">' ~ 'onboarding.company.analyze'|trans ~ ' →</button>'}) }}
{{ form_end(form) }}
{% endblock %}
