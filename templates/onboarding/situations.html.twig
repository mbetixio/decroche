{% extends 'onboarding/layout.html.twig' %}
{% block heading %}{{ 'onboarding.situations.title'|trans }}{% endblock %}
{% block lead %}<p class="lead">{{ 'onboarding.situations.lead'|trans({'%count%': form.situations|length}) }}</p>{% endblock %}
{% block content %}
{{ form_start(form, {attr: {class: 'form'}}) }}
    {{ form_errors(form) }}{{ form_errors(form.situations) }}
    {{ include('settings/_situations.html.twig') }}
    {{ include('onboarding/_foot.html.twig', {label: 'action.continue'|trans}) }}
{{ form_end(form) }}
{% endblock %}
