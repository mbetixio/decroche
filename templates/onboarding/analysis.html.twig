{% extends 'onboarding/layout.html.twig' %}
{% block heading %}{{ 'onboarding.analysis.title'|trans }}{% endblock %}
{% block lead %}<p class="lead">{{ 'onboarding.analysis.lead'|trans({'%company%': company().name}) }}</p>{% endblock %}
{% block content %}
<div class="stack" data-controller="analysis"
     data-analysis-url-value="{{ path('onboarding_analyze') }}"
     data-analysis-token-value="{{ csrf_token('onboarding-analysis') }}">
    {{ include('_steps.html.twig') }}
    <p class="small muted" role="status" data-analysis-target="status">{{ 'onboarding.analysis.wait'|trans }}</p>
    <div class="row" data-analysis-target="retry" hidden>
        <a class="btn" href="{{ path('onboarding', {step: 'company'}) }}"><twig:Icon name="arrow-left" />{{ 'onboarding.analysis.edit'|trans }}</a>
        <button type="button" class="btn primary" data-action="analysis#run"><twig:Icon name="refresh" />{{ 'action.retry'|trans }}</button>
    </div>
</div>
{% endblock %}
