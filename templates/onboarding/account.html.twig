{% extends 'onboarding/layout.html.twig' %}
{% block heading %}{{ 'onboarding.account.title'|trans }}{% endblock %}
{% block lead %}<p class="lead">{{ 'onboarding.account.lead'|trans }}</p>{% endblock %}
{% block content %}
{{ form_start(form, {attr: {class: 'form'}}) }}
    <div class="fields-2">{{ form_row(form.name) }}{{ form_row(form.email) }}</div>
    {{ form_row(form.password) }}
    {{ form_row(form.profile) }}
    {{ include('onboarding/_foot.html.twig', {label: 'onboarding.account.submit'|trans}) }}
{{ form_end(form) }}
{% endblock %}
