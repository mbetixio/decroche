{% extends 'onboarding/layout.html.twig' %}
{% block heading %}{{ 'onboarding.account.title'|trans }}{% endblock %}
{% block lead %}<p class="lead">{{ 'onboarding.account.lead'|trans }}</p>{% endblock %}
{% block content %}
{{ form_start(form, {attr: {class: 'form card pad-l'}}) }}
    <div class="cols-2">{{ form_row(form.name) }}{{ form_row(form.email) }}</div>
    {{ form_row(form.password) }}
    {{ form_row(form.profile) }}
    {{ include('onboarding/_foot.html.twig', {actions: '<button class="btn primary lg">' ~ 'onboarding.account.submit'|trans ~ ' →</button>'}) }}
{{ form_end(form) }}
{% endblock %}
