{% extends 'base.html.twig' %}
{% block title %}{{ 'onboarding.waiting.title'|trans }}{% endblock %}
{% block page %}
<main class="auth-main full" id="main">
    <div class="auth-card">
        <twig:Brand />
        <h1>{{ 'onboarding.waiting.title'|trans }}</h1>
        <p class="lead">{{ 'onboarding.waiting.text'|trans({'%company%': company().name ?: 'Décroche'}) }}</p>
        <div><a class="btn ghost" href="{{ logout_path() }}"><twig:Icon name="logout" />{{ 'nav.logout'|trans }}</a></div>
    </div>
</main>
{% endblock %}
