{% extends 'security/_layout.html.twig' %}
{% block title %}{{ 'security.join'|trans }}{% endblock %}
{% block content %}
{% if invitation %}
    <header class="stack stack-s"><h1>{{ 'security.join_title'|trans({'%company%': company().name}) }}</h1><p class="muted">{{ 'security.join_lead'|trans({'%email%': invitation.email, '%name%': invitation.invitedBy ? invitation.invitedBy.name : company().name}) }}</p></header>
    {{ form_start(form, {attr: {class: 'form'}}) }}
        {{ form_rest(form) }}
        <button class="btn primary lg block">{{ 'security.join_submit'|trans }}</button>
    {{ form_end(form) }}
{% else %}
    <header class="stack stack-s"><h1>{{ 'security.join_invalid'|trans }}</h1><p class="muted">{{ 'security.join_invalid_text'|trans }}</p></header>
    <a class="btn block" href="{{ path('login') }}">{{ 'security.login'|trans }}</a>
{% endif %}
{% endblock %}
