{% extends 'base.html.twig' %}
{% block title %}Rejoindre l'équipe{% endblock %}
{% block body %}
<div style="max-width:440px;margin:50px auto" class="stack">
  <div class="logo" style="font-size:24px;justify-content:center"><b>S</b> Sparring</div>
  {% if invitation %}
  <form method="post" class="card stack">
    <h2>Rejoindre {{ invitation.workspace.name }}</h2>
    <p class="small muted">{{ invitation.invitedBy ? invitation.invitedBy.name ~ ' vous' : 'On vous' }} invite à vous entraîner sur Sparring avec l'équipe{{ invitation.role == 'manager' ? ', en tant que manager' : '' }}.</p>
    {% if error %}<div class="flash error">{{ error }}</div>{% endif %}
    <div><label>E-mail</label><input value="{{ invitation.email }}" disabled></div>
    <div><label for="n">Votre nom</label><input id="n" name="name" value="{{ values.name ?? '' }}" required autofocus></div>
    <div><label for="p">Mot de passe (8 caractères au moins)</label><input id="p" type="password" name="password" required minlength="8" autocomplete="new-password"></div>
    <input type="hidden" name="_token" value="{{ csrf_token('join' ~ invitation.id) }}">
    <button class="btn primary">Créer mon compte</button>
  </form>
  {% else %}
  <div class="card empty stack"><h2>Invitation introuvable</h2><p>Ce lien a déjà servi ou a été retiré. Demandez-en un nouveau à votre manager.</p><a class="btn" href="{{ path('login') }}">Se connecter</a></div>
  {% endif %}
</div>
{% endblock %}
