{# The sign-in pages: the form first; beside it (below it on phones), a statement and a call writing itself. #}
{% extends 'base.html.twig' %}
{% block page %}
<div class="auth">
    <aside class="auth-side">
        <twig:Brand :tagline="company().name" />
        <p class="auth-statement">{{ 'security.statement'|trans|raw }}</p>
        {{ include('_call_log.html.twig') }}
    </aside>
    <main class="auth-main" id="main">
        <div class="auth-card">
            <twig:Brand class="brand auth-mobile-brand" :tagline="company().name" />
            {{ include('_flashes.html.twig') }}
            {% block content %}{% endblock %}
        </div>
        {% if source_url %}<a class="source-link" href="{{ source_url }}" rel="noopener">{{ 'meta.source'|trans }}</a>{% endif %}
    </main>
</div>
{% endblock %}
