{# The sign-in pages: a statement and a call writing itself on the left, the form on the right. #}
{% extends 'base.html.twig' %}
{% block page %}
<div class="auth">
    <aside class="auth-side">
        <div class="brand"><img class="brand-logo" src="/brand/logo.svg" alt="" width="38" height="38"><span>Practicall<small>{{ company().name }}</small></span></div>
        <p class="auth-statement">{{ 'security.statement'|trans|raw }}</p>
        {{ include('_call_log.html.twig') }}
    </aside>
    <main class="auth-main" id="main">
        <div class="auth-card">
            {{ include('_flashes.html.twig') }}
            {% block content %}{% endblock %}
        </div>
    </main>
</div>
{% endblock %}
