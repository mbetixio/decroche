{% extends 'security/_layout.html.twig' %}
{% block title %}{{ 'security.login'|trans }}{% endblock %}
{% block content %}
<header class="stack stack-s"><h1>{{ 'security.login_title'|trans }}</h1><p class="muted">{{ 'security.login_lead'|trans }}</p></header>
{% if error %}<div class="notice error flash" role="alert"><twig:Icon name="alert" /><span>{{ error.messageKey|trans(error.messageData, 'security') }}</span></div>{% endif %}
<form method="post" action="{{ path('login') }}" class="form">
    <div class="field"><label for="email">{{ 'form.email'|trans }}</label><input id="email" type="email" name="_username" value="{{ last }}" autocomplete="email" required autofocus></div>
    <div class="field"><label for="password">{{ 'form.password'|trans }}</label><input id="password" type="password" name="_password" autocomplete="current-password" required></div>
    <label class="check"><input type="checkbox" name="_remember_me" checked> <span>{{ 'security.remember'|trans }}</span></label>
    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
    <button class="btn primary lg block">{{ 'security.login'|trans }}</button>
</form>
<p class="small faint">{{ 'security.lost'|trans }}</p>
{% endblock %}
