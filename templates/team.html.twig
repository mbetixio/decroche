{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block title %}Équipe{% endblock %}
{% block body %}
<div class="head"><div><h1>Le tableau de l'équipe</h1><p class="muted">Qui s'entraîne, son niveau, ses résultats, et ce qu'il doit travailler. Cliquez sur un commercial pour le détail.</p></div><a class="btn" href="{{ path('scenario_new') }}">+ Écrire un scénario</a></div>

<div class="card table-wrap"><table>
  <tr><th>Commercial</th><th>Niveau</th><th>Appels</th><th>Moyenne</th><th>Dernière</th><th>Tendance</th><th>Objectifs atteints</th><th>Série</th><th>À travailler</th><th>Dernier appel</th></tr>
  {% for row in sellers %}{% set st = row.stats %}
  <tr>
    <td><a href="{{ path('team_seller', {id: row.seller.id}) }}" class="row" style="text-decoration:none;flex-wrap:nowrap"><span class="avatar">{{ row.seller.initials }}</span><span><b>{{ row.seller.name }}</b>{% if row.seller.manager %} <span class="tag">manager</span>{% endif %}<div class="small muted">{{ row.seller.email }}</div></span></a></td>
    <td class="small"><b>{{ st.level.number }} · {{ st.level.name }}</b><div class="muted">{{ st.xp }} XP</div></td>
    <td>{{ st.done }}{% if st.abandoned %} <span class="small muted">(+{{ st.abandoned }} ab.)</span>{% endif %}</td>
    <td>{{ m.score(st.average) }}</td><td>{{ m.score(st.last) }}</td>
    <td>{% if st.trend is null %}<span class="muted">—</span>{% else %}<span class="tag {{ st.trend >= 0 ? 'good' : 'bad' }}">{{ st.trend >= 0 ? '▲ +' : '▼ ' }}{{ st.trend }}</span>{% endif %}</td>
    <td>{{ st.done ? (st.goals / st.done * 100)|round ~ ' %' : '—' }}</td>
    <td>{{ st.streak ? '🔥 ' ~ st.streak : '—' }}</td>
    <td class="small">{{ st.weakest ? st.criteria[st.weakest].label : '—' }}</td>
    <td class="small muted">{{ row.lastAt ? row.lastAt|date('d/m H:i') : 'jamais' }}</td>
  </tr>
  {% endfor %}
</table></div>

<div class="card stack" style="margin-top:20px">
  <h2>🎯 Les missions</h2>
  <form method="post" action="{{ path('team_mission') }}" class="mission-form">
    <input type="hidden" name="_token" value="{{ csrf_token('team_mission') }}">
    <div><label>Pour</label><select name="assignee"><option value="0">Toute l'équipe</option>{% for s in members %}<option value="{{ s.id }}">{{ s.name }}</option>{% endfor %}</select></div>
    <div><label>Appels</label><input type="number" name="calls" value="3" min="1" max="20"></div>
    <div><label>Situation</label><select name="situation"><option value="">N'importe laquelle</option>{% for key, sit in space.situations %}<option value="{{ key }}">{{ sit.emoji }} {{ sit.label }}</option>{% endfor %}</select></div>
    <div><label>Note visée</label><input type="number" name="target" value="70" min="0" max="100"></div>
    <div><label>Avant le</label><input type="date" name="due"></div>
    <div class="wide"><label>Le mot du manager (facultatif)</label><input name="note" maxlength="200" placeholder="Ex. : on prépare le salon de mars, entraînez-vous sur les rappels de salon"></div>
    <div><button class="btn dark">Donner la mission</button></div>
  </form>
  {% for row in missions %}{% set mi = row.mission %}{% set sit = mi.situation ? space.situations[mi.situation] ?? null : null %}
    <div class="mission">
      <div class="row between"><div><b>{{ mi.calls }} appel{{ mi.calls > 1 ? 's' }} {{ sit ? '« ' ~ sit.emoji ~ ' ' ~ sit.label ~ ' »' : 'au choix' }} à {{ mi.target }}+</b> <span class="muted small">· {{ mi.assignee ? mi.assignee.name : 'toute l\'équipe' }}{{ mi.dueAt ? ' · avant le ' ~ mi.dueAt|date('d/m') }}</span>{% if mi.note %}<div class="small muted">« {{ mi.note }} »</div>{% endif %}</div>
        <form method="post" action="{{ path('team_mission_remove', {id: mi.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('mission' ~ mi.id) }}"><button class="btn ghost small">Retirer</button></form></div>
      <div class="mission-members">{% for mb in row.members %}<span class="tag {{ mb.done >= mi.calls ? 'good' }}">{{ mb.seller.name }} {{ mb.done }}/{{ mi.calls }}</span>{% else %}<span class="muted small">Personne n'est concerné.</span>{% endfor %}</div>
    </div>
  {% else %}<p class="small muted">Donnez un objectif à un commercial ou à l'équipe : il le retrouve sur sa page d'accueil, avec sa progression.</p>{% endfor %}
</div>

<div class="cols2" style="margin-top:20px">
  <div class="card stack">
    <h2>✉️ Inviter dans l'espace</h2>
    <form method="post" action="{{ path('team_invite') }}" class="stack">
      <input type="hidden" name="_token" value="{{ csrf_token('team_invite') }}">
      <div><label>E-mail</label><input type="email" name="email" required placeholder="prenom.nom@{{ app.user.email|split('@')|last }}"></div>
      <label class="row" style="font-weight:400"><input type="checkbox" name="manager" value="1" style="width:auto"> Manager (gère l'espace, voit l'équipe)</label>
      <div><button class="btn dark">Créer l'invitation</button></div>
    </form>
    <p class="small muted">Un lien personnel est créé : envoyez-le à la personne. Elle crée son compte, se présente, et s'entraîne sur les situations de {{ space.name }}. {{ sellers|length }} membre{{ sellers|length > 1 ? 's' }} dans l'espace.</p>
    {% for i in invitations %}
      <div class="invite"><div class="row between"><b>{{ i.email }}</b>{% if i.role == 'manager' %}<span class="tag">manager</span>{% endif %}<form method="post" action="{{ path('team_invite_cancel', {id: i.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ i.id) }}"><button class="btn ghost small">Retirer</button></form></div>
        <input readonly value="{{ url('join', {token: i.token}) }}" onclick="this.select()" style="font-family:monospace;font-size:12px;margin-top:4px"></div>
    {% endfor %}
  </div>
  <div class="card table-wrap"><h2>Par type de situation</h2><table>
    <tr><th>Situation</th><th>Appels</th><th>Moyenne</th><th>Objectifs</th></tr>
    {% for x in situations %}<tr><td>{{ x.emoji }} {{ x.label }}</td><td>{{ x.calls }}</td><td>{{ m.score(x.average) }}</td><td>{{ x.goals }} %</td></tr>{% else %}<tr><td class="empty" colspan="4">Aucun appel encore.</td></tr>{% endfor %}
  </table></div>
</div>

<div class="cols2" style="margin-top:20px">
  <div class="card table-wrap"><h2>Les derniers appels</h2><table>
    {% for t in recent %}{% set sit = t.scenario.situationInfo %}<tr><td class="small">{{ t.startedAt|date('d/m H:i') }}</td><td>{{ t.seller.name }}</td><td class="small">{{ sit ? sit.emoji ~ ' ' }}{{ t.scenario.title }}</td><td>{% if t.status == 'done' %}{{ m.goal(t.debrief.goal_reached ?? null) }}{% else %}{{ m.status(t) }}{% endif %}</td><td>{{ m.score(t.score) }}</td><td><a href="{{ path('training', {id: t.id}) }}">Voir</a></td></tr>{% else %}<tr><td class="empty">Personne ne s'est encore entraîné.</td></tr>{% endfor %}
  </table></div>
  <div class="card table-wrap"><h2>La bibliothèque</h2><table>
    <tr><th>Scénario</th><th>Sessions</th><th>Moyenne</th></tr>
    {% for row in scenarios %}<tr><td><a href="{{ path('scenario', {id: row.scenario.id}) }}">{{ row.scenario.title }}</a>{% if not row.scenario.active %} <span class="tag bad">archivé</span>{% endif %}{% if row.scenario.author and not row.scenario.author.manager %} <span class="tag">de {{ row.scenario.author.name }}</span>{% endif %}</td><td>{{ row.sessions }}</td><td>{{ m.score(row.average) }}</td></tr>{% endfor %}
  </table></div>
</div>
{% endblock %}
