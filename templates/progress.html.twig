{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% set me = seller == app.user %}
{% set lv = stats.level %}
{% block title %}{{ me ? 'Ma progression' : seller.name }}{% endblock %}
{% block body %}
<div class="head">
  <div class="row" style="flex-wrap:nowrap">
    <span class="avatar" style="width:56px;height:56px;font-size:18px">{{ seller.initials }}</span>
    <div><h1>{{ me ? 'Ma progression' : seller.name }}</h1><p class="muted">Niveau {{ lv.number }} · <b>{{ lv.name }}</b> · {{ lv.xp }} XP{% if stats.streak %} · 🔥 {{ stats.streak }} jour{{ stats.streak > 1 ? 's' }} d'affilée{% endif %}{% if not me %} · {{ seller.email }}{% endif %}</p></div>
  </div>
  {% if not me %}<div class="row">
    {% if seller != app.user %}
    <form method="post" action="{{ path('team_password', {id: seller.id}) }}" onsubmit="return confirm('Générer un nouveau mot de passe provisoire ?')"><input type="hidden" name="_token" value="{{ csrf_token('password' ~ seller.id) }}"><button class="btn ghost">Nouveau mot de passe</button></form>
    <form method="post" action="{{ path('team_role', {id: seller.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('role' ~ seller.id) }}"><button class="btn ghost">{{ seller.manager ? 'Rendre commercial' : 'Nommer manager' }}</button></form>
    {% endif %}
    <a class="btn" href="{{ path('team') }}">← L'équipe</a>
  </div>{% endif %}
</div>
<div class="card" style="margin-bottom:16px"><div class="row between small"><span>Niveau {{ lv.number }} · {{ lv.name }}</span><span class="muted">{% if lv.to %}{{ lv.xp }} / {{ lv.to }} XP → {{ lv.next }}{% else %}Niveau maximal{% endif %}</span></div><div class="bar" style="margin-top:8px;height:10px"><i style="width: {{ lv.pct }}%"></i></div></div>
<div class="kpis">
  <div class="kpi"><b>{{ stats.done }}</b><span>appels analysés{% if stats.abandoned %} (+{{ stats.abandoned }} abandonnés){% endif %}</span></div>
  <div class="kpi"><b>{{ m.score(stats.average) }}</b><span>note moyenne / 100</span></div>
  <div class="kpi"><b>{{ stats.done ? (stats.goals / stats.done * 100)|round ~ ' %' : '—' }}</b><span>d'appels à objectif atteint</span></div>
  <div class="kpi"><b>{% if stats.trend is null %}—{% else %}{{ stats.trend >= 0 ? '+' }}{{ stats.trend }}{% endif %}</b><span>tendance (3 derniers vs 3 d'avant)</span></div>
  <div class="kpi"><b>{{ stats.discovery is null ? '—' : stats.discovery ~ ' %' }}</b><span>du brief caché découvert</span></div>
</div>
<div class="cols2">
  <div class="card"><h2>L'évolution des notes</h2>{% include '_spark.html.twig' with {scores: stats.scores} %}</div>
  <div class="card">
    <h2>Moyenne par critère</h2>
    {% for key, c in stats.criteria %}
      <div class="crit">
        <div><b>{{ c.label }}</b>{% if key == stats.weakest and stats.done %} <span class="tag bad">à travailler</span>{% elseif key == stats.strongest and stats.done %} <span class="tag good">point fort</span>{% endif %}</div>
        {{ m.bar(c.average ?? 0, 10) }}
        <div class="n">{{ c.average ?? '—' }}</div>
      </div>
    {% endfor %}
  </div>
</div>
{% if stats.bySituation %}
<div class="card table-wrap" style="margin-top:16px"><h2>Par type de situation</h2><table>
  <tr><th>Situation</th><th>Appels</th><th>Moyenne</th><th>Objectifs atteints</th></tr>
  {% for x in stats.bySituation %}<tr><td>{{ x.emoji }} {{ x.label }}</td><td>{{ x.calls }}</td><td>{{ m.score(x.average) }}</td><td>{{ x.goals }} %</td></tr>{% endfor %}
</table></div>
{% endif %}
<h2 style="margin-top:24px">Historique</h2>
<div class="card table-wrap"><table>
  <tr><th>Date</th><th>Situation</th><th>Résultat</th><th>Découvert</th><th>Note</th><th></th></tr>
  {% for t in history %}{% set sit = t.scenario.situationInfo %}<tr>
    <td class="small">{{ t.startedAt|date('d/m/Y H:i') }}</td>
    <td>{{ sit ? sit.emoji ~ ' ' }}{{ t.scenario.title }}<div class="small muted">{{ sit ? sit.label : t.scenario.categoryLabel }}</div></td>
    <td class="small">{% if t.status == 'done' %}{{ m.goal(t.debrief.goal_reached ?? null) }} {{ t.debrief.result ?? '' }}{% else %}{{ m.status(t) }}{% endif %}</td>
    <td class="small">{{ t.status == 'done' ? t.revealed|length ~ ' / ' ~ t.briefSheet|length : '' }}</td>
    <td>{{ m.score(t.score) }}</td><td style="text-align:right"><a href="{{ path('training', {id: t.id}) }}">Ouvrir</a></td></tr>
  {% else %}<tr><td colspan="6" class="empty">Aucun appel encore. <a href="{{ path('home') }}">Lancez-vous</a>.</td></tr>{% endfor %}
</table></div>
{% endblock %}
