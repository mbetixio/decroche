{# Le débrief d'une session : sur le site et dans l'app MCP. t : la session. #}
{% import '_macros.html.twig' as m %}
{% set d = t.debrief %}
{% set s = t.scenario %}
<div class="debrief">
{% if t.status == 'abandoned' %}
  <div class="card">
    <span class="tag bad">Session abandonnée</span>
    <h2 style="margin-top:10px">{{ s.title }}</h2>
    <p class="muted">Pas de note pour une session abandonnée. Voici tout de même le brief caché de {{ s.persona.name }}, pour la prochaine fois.</p>
  </div>
{% elseif d is null %}
  <div class="card empty">Le débrief n'est pas encore rédigé.</div>
{% else %}
  <div class="card hero">
    {% set c = t.score >= 70 ? 'var(--good)' : (t.score >= 45 ? 'var(--warn)' : 'var(--bad)') %}
    <div class="ring" style="--v: {{ t.score }}; --c: {{ c }}"><div><div><b>{{ t.score }}</b><br><span>sur 100</span></div></div></div>
    <div>
      {% if d.result ?? false %}<div class="verdict" style="margin-bottom:6px">{{ d.result }}</div>{% endif %}
      <div class="row" style="margin-bottom:6px">
        {{ m.goal(d.goal_reached ?? null) }}
        {% if xp ?? false %}<span class="tag brand">+{{ xp }} XP</span>{% endif %}
        <span class="tag">{{ s.categoryLabel }}</span><span class="tag">{{ s.difficultyLabel }}</span>
        {% if d.next_step %}<span class="tag good">Prochaine étape obtenue</span>{% else %}<span class="tag bad">Pas de prochaine étape</span>{% endif %}
        <span class="tag">{{ t.revealed|length }} / {{ d.brief|length }} rubriques découvertes</span>
      </div>
      {% if standalone ?? false %}<h2 style="margin-bottom:6px">{{ s.title }}</h2>{% endif %}
      <p>{{ d.summary }}</p>
      {% if d.outcome %}<p class="muted small">{{ d.outcome }}</p>{% endif %}
    </div>
  </div>

  {% if d.objectives ?? [] %}
  <div class="card">
    <h2>🎯 Les objectifs de l'appel</h2>
    <ul class="objectives">
      {% for o in d.objectives %}<li><span>{{ o.status == 'atteint' ? '✅' : (o.status == 'partiel' ? '◐' : '❌') }}</span><div><b>{{ o.objective }}</b>{% if o.evidence %}<div class="small muted">{{ o.evidence }}</div>{% endif %}</div></li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  <div class="card">
    <h2>Les {{ d.criteria|length }} critères</h2>
    {% for key, c in d.criteria %}
      <div class="crit">
        <b>{{ c.label }}</b>
        {{ m.bar(c.score, 10) }}
        <div class="n">{{ c.score }}/10</div>
        <div class="muted small comment">{{ c.comment }}</div>
      </div>
    {% endfor %}
  </div>
{% endif %}

{% set sp = d.speech ?? null %}
{% if sp and t.status == 'done' %}
  <div class="card">
    <h2>{{ sp.voice ? '🎙️' : '💬' }} L'appel en chiffres</h2>
    <div class="kpis" style="margin:10px 0 0">
      <div class="kpi"><b>{{ sp.talk_share }} %</b><span>de temps de parole{{ sp.talk_share > 60 ? ' : laissez parler le client' : (sp.talk_share < 25 ? ' : prenez votre place' : '') }}</span></div>
      <div class="kpi"><b>{{ sp.questions }}</b><span>questions, dont {{ sp.open_questions }} ouvertes</span></div>
      <div class="kpi"><b>{{ sp.fillers }}</b><span>tics de langage{% if sp.filler_words %} ({{ sp.filler_words|keys|join(', ') }}){% endif %}</span></div>
      {% if sp.wpm %}<div class="kpi"><b>{{ sp.wpm }}</b><span>mots par minute{{ sp.wpm > 170 ? ' : ralentissez' : (sp.wpm < 110 ? ' : un peu lent' : ' : bon rythme') }}</span></div>{% endif %}
      <div class="kpi"><b>{{ sp.longest }}</b><span>mots dans votre plus longue tirade</span></div>
      {% if sp.reply_delay is not null %}<div class="kpi"><b>{{ sp.reply_delay }} s</b><span>délai moyen avant de répondre</span></div>{% endif %}
    </div>
    {% if d.speech_comment ?? false %}<p class="small muted" style="margin-top:10px">{{ d.speech_comment }}</p>{% endif %}
  </div>
{% endif %}

{% set brief = t.status in ['done', 'abandoned'] ? t.briefSheet : [] %}
{% if brief %}
  <div class="card">
    <h2>Le brief caché de {{ s.persona.name }}</h2>
    {% if s.brief.setup ?? false %}<p class="small" style="margin-bottom:6px"><b>De son côté :</b> {{ s.brief.setup }}</p>{% endif %}
    {% set missed = {} %}{% for x in d.missed ?? [] %}{% set missed = missed|merge({(x.rubric): x}) %}{% endfor %}
    {% for b in brief %}
      <div class="brief-item">
        <div title="{{ b.found ? 'Découvert' : 'Manqué' }}">{{ b.found ? '✅' : '❌' }}</div>
        <div>
          <b>{{ b.label }}</b> — {{ b.text }}
          {% if not b.found and missed[b.key] is defined %}
            <div class="muted small" style="margin-top:4px">💡 {{ missed[b.key].how }}</div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
{% endif %}

{% if d is not null and t.status == 'done' %}
  <div class="cols2">
    <div class="card">
      <h2>Les meilleures répliques</h2>
      {% for q in d.best %}<div class="quote good"><q>{{ q.quote }}</q><div class="muted small">{{ q.why }}</div></div>{% else %}<p class="muted">Aucune réplique ne se détache.</p>{% endfor %}
    </div>
    <div class="card">
      <h2>Les répliques à retravailler</h2>
      {% for q in d.worst %}<div class="quote bad"><q>{{ q.quote }}</q><div class="muted small">{{ q.why }}</div>{% if q.better %}<div class="small" style="margin-top:4px">👉 <i>{{ q.better }}</i></div>{% endif %}{% set line = t is defined and mine is defined and mine ? t.lineOf(q.quote) : null %}{% if line is not null %}<form method="post" action="{{ path('training_replay', {id: t.id, n: line}) }}" style="margin-top:8px"><input type="hidden" name="_token" value="{{ csrf_token('replay' ~ t.id) }}"><button class="btn small">↺ Rejouer ce moment</button></form>{% endif %}</div>{% else %}<p class="muted">Rien de rédhibitoire.</p>{% endfor %}
    </div>
  </div>
  <div class="card">
    <h2>Trois conseils pour la prochaine fois</h2>
    <ol class="tips">{% for tip in d.tips %}<li><span>{{ tip }}</span></li>{% endfor %}</ol>
  </div>
{% endif %}
</div>
