:root {
  --bg: #f5f6f8; --card: #ffffff; --ink: #18202b; --muted: #637083; --line: #e2e6ec;
  --brand: #e2552d; --brand-ink: #ffffff; --brand-soft: #fdebe5;
  --good: #1f8a5b; --good-soft: #e3f4ec; --bad: #c2362f; --bad-soft: #fbe6e4; --warn: #b7791f; --warn-soft: #fbf1df;
  --me: #18202b; --me-ink: #ffffff; --them: #ffffff;
  --radius: 12px; --sans: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font: 15px/1.5 var(--sans); color: var(--ink); background: var(--bg); }
a { color: inherit; }
h1 { font-size: 26px; line-height: 1.2; letter-spacing: -.01em; }
h2 { font-size: 18px; margin-bottom: 10px; }
h3 { font-size: 15px; margin-bottom: 6px; }
p + p { margin-top: 8px; }
.muted { color: var(--muted); }
.small { font-size: 13px; }
.wrap { max-width: 1120px; margin: 0 auto; padding: 24px 16px 60px; }
.top { background: var(--card); border-bottom: 1px solid var(--line); }
.top .wrap { display: flex; align-items: center; gap: 22px; padding-top: 12px; padding-bottom: 12px; flex-wrap: wrap; }
.logo { font-weight: 800; font-size: 19px; text-decoration: none; display: flex; align-items: center; gap: 8px; }
.logo b { background: var(--brand); color: var(--brand-ink); border-radius: 8px; width: 30px; height: 30px; display: grid; place-items: center; font-size: 16px; }
.nav { display: flex; gap: 4px; flex: 1; flex-wrap: wrap; }
.nav a { text-decoration: none; padding: 6px 12px; border-radius: 8px; color: var(--muted); font-weight: 600; font-size: 14px; }
.nav a.on, .nav a:hover { background: var(--bg); color: var(--ink); }
.who { display: flex; align-items: center; gap: 10px; font-size: 14px; }
.avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; font-size: 12px; font-weight: 700; flex: none; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; }
.grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
.stack { display: grid; gap: 16px; }
.row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.between { justify-content: space-between; }
.head { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
.tag { display: inline-block; font-size: 12px; font-weight: 600; padding: 2px 9px; border-radius: 99px; background: var(--bg); color: var(--muted); border: 1px solid var(--line); }
.tag.brand { background: var(--brand-soft); color: var(--brand); border-color: transparent; }
.tag.good { background: var(--good-soft); color: var(--good); border-color: transparent; }
.tag.bad { background: var(--bad-soft); color: var(--bad); border-color: transparent; }
.tag.warn { background: var(--warn-soft); color: var(--warn); border-color: transparent; }
.btn { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line); background: var(--card); color: var(--ink); padding: 9px 16px; border-radius: 9px; font: 600 14px var(--sans); cursor: pointer; text-decoration: none; }
.btn:hover { border-color: var(--muted); }
.btn.primary { background: var(--brand); border-color: var(--brand); color: var(--brand-ink); }
.btn.primary:hover { filter: brightness(.95); }
.btn.dark { background: var(--ink); border-color: var(--ink); color: #fff; }
.btn.ghost { background: transparent; border-color: transparent; color: var(--muted); }
.btn:disabled { opacity: .5; cursor: wait; }
label { display: block; font-weight: 600; font-size: 13px; margin-bottom: 4px; }
input, textarea, select { width: 100%; font: 15px var(--sans); padding: 9px 12px; border: 1px solid var(--line); border-radius: 9px; background: #fff; color: var(--ink); }
textarea { resize: vertical; min-height: 80px; }
input:focus, textarea:focus, select:focus { outline: 2px solid var(--brand-soft); border-color: var(--brand); }
.field + .field { margin-top: 14px; }
.cols2 { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }
.cols3 { display: grid; gap: 14px; grid-template-columns: repeat(3, 1fr); }
.flash { padding: 10px 14px; border-radius: 9px; margin-bottom: 16px; background: var(--good-soft); color: var(--good); font-weight: 600; }
.flash.error { background: var(--bad-soft); color: var(--bad); }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th { text-align: left; color: var(--muted); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; padding: 8px 10px; border-bottom: 1px solid var(--line); }
td { padding: 10px; border-bottom: 1px solid var(--line); vertical-align: middle; }
tr:last-child td { border-bottom: 0; }
.table-wrap { overflow-x: auto; }
.score { font-weight: 800; font-variant-numeric: tabular-nums; }
.score.hi { color: var(--good); } .score.mid { color: var(--warn); } .score.lo { color: var(--bad); }
.kpis { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); margin-bottom: 16px; }
.kpi { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; }
.kpi b { display: block; font-size: 26px; line-height: 1.1; font-variant-numeric: tabular-nums; }
.kpi > span { color: var(--muted); font-size: 13px; }
.bar { height: 8px; background: var(--bg); border-radius: 99px; overflow: hidden; }
.bar i { display: block; height: 100%; border-radius: 99px; background: var(--brand); }
.bar.good i { background: var(--good); } .bar.mid i { background: var(--warn); } .bar.lo i { background: var(--bad); }
.crit { display: grid; grid-template-columns: 220px 1fr 50px; gap: 4px 14px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--line); }
.crit:last-child { border-bottom: 0; }
.crit .comment { grid-column: 1 / -1; }
.crit .n { text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }
.persona { display: flex; gap: 12px; align-items: center; }
.persona .avatar { width: 44px; height: 44px; font-size: 15px; background: var(--brand); }
.scenario-card { display: flex; flex-direction: column; gap: 10px; }
.scenario-card .grow { flex: 1; }
.empty { text-align: center; padding: 40px 20px; color: var(--muted); }

/* Le chat */
.chat { display: grid; grid-template-columns: 1fr 300px; gap: 16px; align-items: start; }
.thread { display: flex; flex-direction: column; gap: 10px; padding: 18px; min-height: 380px; max-height: 62vh; overflow-y: auto; }
.msg { max-width: 78%; padding: 10px 14px; border-radius: 14px; white-space: pre-wrap; }
.msg.persona { background: var(--bg); border-top-left-radius: 4px; align-self: flex-start; }
.msg.seller { background: var(--me); color: var(--me-ink); border-top-right-radius: 4px; align-self: flex-end; }
.msg.typing { color: var(--muted); font-style: italic; }
.composer { display: flex; gap: 10px; padding: 14px; border-top: 1px solid var(--line); }
.composer textarea { min-height: 48px; height: 48px; }
.clock { font-size: 32px; font-weight: 800; font-variant-numeric: tabular-nums; }
.clock.late { color: var(--bad); }
.dots { display: flex; gap: 6px; flex-wrap: wrap; }
.dots i { width: 14px; height: 14px; border-radius: 50%; background: var(--line); }
.dots i.on { background: var(--good); }

/* Le débrief */
.debrief { display: grid; gap: 16px; }
.hero { display: grid; grid-template-columns: 130px 1fr; gap: 20px; align-items: center; }
.ring { width: 130px; height: 130px; border-radius: 50%; display: grid; place-items: center; background: conic-gradient(var(--c) calc(var(--v) * 1%), var(--bg) 0); }
.ring div { width: 104px; height: 104px; border-radius: 50%; background: var(--card); display: grid; place-items: center; text-align: center; }
.ring b { font-size: 34px; line-height: 1; } .ring span { font-size: 12px; color: var(--muted); }
.brief-item { display: grid; grid-template-columns: 26px 1fr; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); }
.brief-item:last-child { border-bottom: 0; }
.quote { border-left: 3px solid var(--line); padding: 4px 0 4px 12px; margin: 8px 0; }
.quote q { font-style: italic; }
.quote.good { border-color: var(--good); } .quote.bad { border-color: var(--bad); }
.tips { counter-reset: tip; list-style: none; display: grid; gap: 10px; }
.tips li { counter-increment: tip; display: grid; grid-template-columns: 28px 1fr; gap: 8px; }
.tips li::before { content: counter(tip); background: var(--brand); color: #fff; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 13px; }
.spark { width: 100%; height: 120px; }

@media (max-width: 820px) {
  .chat, .cols2, .cols3, .hero { grid-template-columns: 1fr; }
  .crit { grid-template-columns: 1fr 50px; } .crit .bar { grid-column: 1 / -1; grid-row: 2; } .crit .comment { grid-row: 3; }
  .msg { max-width: 92%; }
}

/* Le jeu */
.play-hero { display: grid; grid-template-columns: 1fr 1.3fr; gap: 16px; }
.level-card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
.mini-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 18px; }
.mini-kpis b { display: block; font-size: 22px; } .mini-kpis span { color: var(--muted); font-size: 12px; }
.call-card { background: linear-gradient(135deg, #18202b, #2b3646); color: #fff; border-radius: var(--radius); padding: 26px; }
.btn.big { margin-top: 18px; font-size: 18px; padding: 14px 26px; background: var(--brand); border-color: var(--brand); color: #fff; border-radius: 12px; }
.situations { display: flex; flex-wrap: wrap; gap: 8px; }
.sit { background: var(--card); border: 1px solid var(--line); border-radius: 99px; padding: 6px 12px; font-size: 13px; }
.dialing { position: fixed; inset: 0; background: #18202bee; color: #fff; display: grid; place-content: center; text-align: center; gap: 10px; z-index: 10; font-size: 18px; }
.dialing[hidden] { display: none; }
.phone { font-size: 64px; animation: ring 1.2s infinite; }
@keyframes ring { 0%, 100% { transform: rotate(0); } 10%, 30% { transform: rotate(-14deg); } 20%, 40% { transform: rotate(14deg); } 50% { transform: rotate(0); } }
.doc { background: #fffdf6; border: 1px solid #ece4cf; border-radius: 10px; padding: 18px 20px; white-space: pre-wrap; font-size: 14px; line-height: 1.6; box-shadow: 0 2px 8px #0000000d; }
.objectives { list-style: none; display: grid; gap: 8px; }
.objectives li { display: grid; grid-template-columns: 26px 1fr; gap: 8px; align-items: start; }
.btn.hangup { background: var(--bad); border-color: var(--bad); color: #fff; }
.verdict { font-size: 20px; font-weight: 800; }
@media (max-width: 820px) { .play-hero { grid-template-columns: 1fr; } }
.offer p { margin-bottom: 12px; line-height: 1.6; }

/* L'écran d'appel : un téléphone, pas un chat */
.callscreen { position: fixed; inset: 0; z-index: 20; background: radial-gradient(120% 80% at 50% 0%, #2b3646 0%, #141a23 60%, #0d1219 100%); color: #fff; display: grid; grid-template-rows: auto 1fr auto auto auto; justify-items: center; padding: 18px 16px 28px; overflow-y: auto; }
.cs-top { width: 100%; max-width: 520px; display: flex; justify-content: space-between; gap: 10px; }
.cs-pill { background: #ffffff14; border-radius: 99px; padding: 5px 12px; font-size: 13px; color: #ffffffcc; }
.cs-pill.late { background: #c2362f; color: #fff; }
.cs-who { display: grid; justify-items: center; align-content: center; gap: 6px; text-align: center; padding: 20px 0; }
.cs-avatar { width: 128px; height: 128px; border-radius: 50%; background: var(--brand); display: grid; place-items: center; font-size: 44px; font-weight: 800; margin-bottom: 14px; position: relative; cursor: default; }
.cs-avatar::before, .cs-avatar::after { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid #e2552d88; opacity: 0; }
[data-state="speaking"] .cs-avatar, [data-state="ringing"] .cs-avatar { cursor: pointer; }
[data-state="speaking"] .cs-avatar::before, [data-state="speaking"] .cs-avatar::after,
[data-state="ringing"] .cs-avatar::before, [data-state="ringing"] .cs-avatar::after,
[data-state="idle"] .cs-avatar::before { animation: wave 1.6s infinite ease-out; }
[data-state="speaking"] .cs-avatar::after, [data-state="ringing"] .cs-avatar::after { animation-delay: .8s; }
@keyframes wave { 0% { transform: scale(1); opacity: .9; } 100% { transform: scale(1.6); opacity: 0; } }
[data-state="thinking"] .cs-avatar { animation: breathe 1.4s infinite ease-in-out; }
@keyframes breathe { 50% { transform: scale(.96); opacity: .8; } }
[data-state="ended"] .cs-avatar { background: #3a4452; }
.cs-name { font-size: 30px; font-weight: 700; }
.cs-sub { color: #ffffffaa; font-size: 15px; }
.cs-status { margin-top: 8px; display: flex; gap: 10px; align-items: center; font-size: 15px; color: #ffffffcc; min-height: 24px; }
.cs-status #since { font-variant-numeric: tabular-nums; color: #3ddc84; font-weight: 600; }
[data-state="listening"] #state, [data-state="talking"] #state { color: #3ddc84; font-weight: 600; }
[data-state="listening"] #state::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #3ddc84; margin-right: 7px; vertical-align: middle; animation: blink 1.2s infinite; }
@keyframes blink { 50% { opacity: .2; } }
[data-state="thinking"] #state::after { content: '…'; }
[data-state="ended"] #state { color: #ff8a80; font-weight: 600; }
.cs-caption { width: 100%; max-width: 560px; min-height: 64px; text-align: center; font-size: 17px; line-height: 1.5; padding: 0 8px 14px; color: #ffffffdd; }
.cs-caption.me { font-style: italic; color: #ffffffb0; }
.cs-caption.me::before { content: '« '; } .cs-caption.me::after { content: ' »'; }
.cs-caption.me:empty::before, .cs-caption.me:empty::after { content: none; }
.cs-caption.sent { color: #ffffff70; }
.cs-caption.them { color: #fff; }
.cs-caption.warn { color: #ffcf8a; font-style: normal; }
.cs-keypad { width: 100%; max-width: 520px; display: flex; gap: 8px; margin-bottom: 16px; }
.cs-keypad[hidden] { display: none; }
.cs-keypad input { flex: 1; background: #ffffff14; border: 1px solid #ffffff2a; color: #fff; border-radius: 99px; padding: 11px 18px; font: 15px var(--sans); }
.cs-keypad input::placeholder { color: #ffffff70; }
.cs-send { width: 44px; height: 44px; border-radius: 50%; border: 0; background: #ffffff22; color: #fff; font-size: 17px; cursor: pointer; }
.cs-controls { display: grid; justify-items: center; gap: 20px; width: 100%; }
.cs-keys { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
.cs-keys[hidden] { display: none; }
.cs-key { background: none; border: 0; color: #fff; display: grid; justify-items: center; gap: 6px; cursor: pointer; font: 12px var(--sans); color: #ffffffbb; width: 72px; }
.cs-key i { font-style: normal; width: 60px; height: 60px; border-radius: 50%; background: #ffffff1c; display: grid; place-items: center; font-size: 23px; transition: background .15s; }
.cs-key:hover i { background: #ffffff2e; }
.cs-key.on i { background: #fff; filter: grayscale(1); }
.cs-main { display: flex; gap: 40px; }
.cs-main form[hidden], .cs-round[hidden] { display: none; }
.cs-round { width: 76px; height: 76px; border-radius: 50%; border: 0; font-size: 32px; cursor: pointer; display: grid; place-items: center; color: #fff; box-shadow: 0 8px 24px #0006; }
.cs-round.pickup { background: #2fbf71; animation: nudge 1.4s infinite; }
@keyframes nudge { 0%, 100% { box-shadow: 0 0 0 0 #2fbf7188; } 50% { box-shadow: 0 0 0 14px #2fbf7100; } }
.cs-round.hangup { background: #e5383b; transform: rotate(135deg); }
.cs-round.hangup:hover { background: #c92a2d; }
.cs-hint { color: #ffffff88; font-size: 13px; text-align: center; max-width: 420px; min-height: 18px; }
.cs-sheet { position: fixed; top: 0; right: 0; bottom: 0; width: min(420px, 100%); background: var(--card); color: var(--ink); z-index: 30; padding: 20px; overflow-y: auto; box-shadow: -10px 0 40px #0008; }
.cs-sheet[hidden] { display: none; }
.cs-key.on i { background: #fff; }
@media (min-width: 900px) { .callscreen.with-sheet { right: 420px; } .cs-sheet { box-shadow: none; border-left: 1px solid var(--line); } }
.transcript { display: grid; gap: 10px; margin-top: 14px; }
.transcript p { display: grid; grid-template-columns: 150px 1fr; gap: 12px; margin: 0; padding: 8px 0; border-bottom: 1px solid var(--line); }
.transcript p:last-child { border-bottom: 0; }
.transcript p b { color: var(--muted); font-size: 13px; }
.transcript p.seller b { color: var(--brand); }
@media (max-width: 600px) { .transcript p { grid-template-columns: 1fr; gap: 2px; } .cs-avatar { width: 104px; height: 104px; font-size: 36px; } .cs-key { width: 60px; } .cs-key i { width: 52px; height: 52px; } }

.transcript form.replay { display: inline-block; margin-left: 8px; vertical-align: middle; }
.transcript form.replay .btn { padding: 2px 8px; font-size: 12px; opacity: .55; }
.transcript p:hover form.replay .btn { opacity: 1; }

/* L'espace de la société */
.sit-edit { border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; }
.sit-edit summary { cursor: pointer; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.invite { border-top: 1px solid var(--line); padding-top: 10px; }

/* Les missions */
.mission-form { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; align-items: end; }
.mission-form .wide { grid-column: span 2; }
.mission { border-top: 1px solid var(--line); padding-top: 10px; }
.mission-members { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
.mission-card.complete { border-color: var(--good); }
