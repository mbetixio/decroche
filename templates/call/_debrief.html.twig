{# A call's debrief, on the website and in the MCP app. call: the call; debrief: its Debrief, or null; mine: whether
   the viewer played it (to replay a moment); standalone: shown outside the site, with the scenario's title.
   Reading order: the verdict, the criteria and objectives, the hidden brief revealed, the lines, the three tips. #}
{% set scenario = call.scenario %}
{% set persona = scenario.persona %}
{% set tones = {reached: 'good', partial: 'warn', missed: 'bad'} %}
<div class="debrief stack stack-l">
{% if call.status.value == 'abandoned' %}
    <section class="notice warn" aria-labelledby="abandoned-title">
        <twig:Icon name="info" />
        <div class="stack stack-s">
            {% if standalone ?? false %}<p class="eyebrow">{{ scenario.title }}</p>{% endif %}
            <h2 id="abandoned-title" class="label">{{ call.status|trans }}</h2>
            <p>{{ 'debrief.abandoned'|trans({'%name%': persona.name}) }}</p>
        </div>
    </section>
{% elseif debrief %}
    {% set tone = call.score >= 70 ? 'good' : (call.score >= 45 ? 'warn' : 'bad') %}
    <section class="panel pad-l verdict" aria-labelledby="verdict-title">
        <div class="verdict-score {{ tone }}">
            <b>{{ call.score }}<small>/100</small></b>
            <div class="bar {{ tone }}" aria-hidden="true"><i style="--pct: {{ call.score }}%"></i></div>
        </div>
        <div class="verdict-body">
            {% if standalone ?? false %}<p class="eyebrow">{{ scenario.title }}</p>{% endif %}
            <h2 id="verdict-title">{{ debrief.result ?: 'debrief.score'|trans }}</h2>
            <p>{{ debrief.summary }}</p>
            {% if debrief.outcome %}<p class="small muted">{{ debrief.outcome }}</p>{% endif %}
            <dl class="facts">
                {% if debrief.goal %}<div><dt>{{ 'debrief.goal_label'|trans }}</dt><dd class="{{ tones[debrief.goal.value] }}">{{ debrief.goal|trans }}</dd></div>{% endif %}
                <div><dt>{{ 'debrief.next_step_label'|trans }}</dt><dd class="{{ debrief.nextStep ? 'good' : 'bad' }}">{{ (debrief.nextStep ? 'debrief.next_step_yes' : 'debrief.next_step_no')|trans }}</dd></div>
                <div><dt>{{ 'debrief.brief_label'|trans }}</dt><dd>{{ 'debrief.uncovered_short'|trans({'%n%': call.revealedCount, '%total%': call.briefSheet|length}) }}</dd></div>
                <div><dt>{{ 'briefing.difficulty'|trans }}</dt><dd>{{ scenario.difficulty|trans }}</dd></div>
            </dl>
        </div>
    </section>

    <div class="halves">
        <section aria-labelledby="criteria-title">
            <div class="section-head"><h2 id="criteria-title">{{ 'debrief.criteria'|trans }}</h2><p>{{ 'debrief.out_of_ten'|trans }}</p></div>
            {# The weakest criterion, under 7, can be trained right away: a new call built to test it. #}
            {% set weakest = debrief.weakest %}
            <div class="criteria">
                {% for key, criterion in debrief.criteria %}
                    {% set ctone = criterion.score >= 7 ? 'good' : (criterion.score >= 5 ? 'warn' : 'bad') %}
                    <div class="criterion">
                        <b>{{ criterion.label }}</b>
                        <span class="score {{ ctone }}">{{ criterion.score }}<small> / 10</small></span>
                        <div class="bar {{ ctone }}" aria-hidden="true"><i style="--pct: {{ criterion.score * 10 }}%"></i></div>
                        <p>{{ criterion.comment }}</p>
                        {% if key == weakest and (mine ?? false) and not call.isLive %}
                            <form method="post" action="{{ path('call_draw') }}" class="train" data-controller="draw" data-action="draw#submit">
                                <input type="hidden" name="token" value="{{ csrf_token('call-draw') }}">
                                <input type="hidden" name="focus" value="{{ key }}">
                                <button class="btn sm"><twig:Icon name="target" />{{ 'debrief.train'|trans }}</button>
                            </form>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </section>
        <div class="stack stack-l">
            {% if debrief.objectives %}
                <section aria-labelledby="objectives-title">
                    <div class="section-head"><h2 id="objectives-title">{{ 'debrief.objectives'|trans }}</h2></div>
                    <ul class="outcomes">
                        {% for objective in debrief.objectives %}
                            <li>
                                <span class="tag {{ tones[objective.status.value] }}">{{ objective.status|trans }}</span>
                                <div><b>{{ objective.objective }}</b>{% if objective.evidence %}<p class="small muted">{{ objective.evidence }}</p>{% endif %}</div>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
            {% if debrief.speech %}
                {% set speech = debrief.speech %}
                <section aria-labelledby="figures-title">
                    <div class="section-head"><h2 id="figures-title">{{ 'debrief.figures'|trans }}</h2></div>
                    <div class="stats">
                        <twig:Stat :label="'debrief.talk_share'|trans" :value="speech.talkShare ~ ' %'" />
                        <twig:Stat :label="'debrief.questions'|trans({'%open%': speech.openQuestions})" :value="speech.questions" />
                        <twig:Stat :label="'debrief.fillers'|trans" :value="speech.fillers" />
                        {% if speech.wordsPerMinute %}<twig:Stat :label="'debrief.wpm'|trans" :value="speech.wordsPerMinute" />{% endif %}
                    </div>
                    {% if debrief.speechComment %}<p class="small muted section-intro">{{ debrief.speechComment }}</p>{% endif %}
                </section>
            {% endif %}
        </div>
    </div>
{% else %}
    <twig:Empty :title="'debrief.pending'|trans" />
{% endif %}

{% if call.status.value in ['done', 'abandoned'] %}
    {% set missed = {} %}
    {% for item in debrief.missed ?? [] %}{% set missed = missed|merge({(item.section.value): item}) %}{% endfor %}
    <section aria-labelledby="brief-title">
        <div class="section-head"><h2 id="brief-title">{{ 'debrief.brief'|trans({'%name%': persona.name}) }}</h2></div>
        {% if scenario.setup %}<p class="section-intro"><b>{{ 'debrief.their_side'|trans }}</b> {{ scenario.setup }}</p>{% endif %}
        <ul class="outcomes">
            {% for item in call.briefSheet %}
                <li>
                    <span class="tag {{ item.found ? 'good' : 'bad' }}">{{ (item.found ? 'debrief.found' : 'debrief.missed')|trans }}</span>
                    <div>
                        <b>{{ item.section|trans }}</b> · {{ item.text }}
                        {% if not item.found and missed[item.section.value] is defined %}<p class="hint"><b>{{ 'debrief.how_to'|trans }}</b> {{ missed[item.section.value].how }}</p>{% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    </section>
    {# What the persona did with their tools during the call, then the files they had at hand. #}
    {% if call.actions %}
        <section aria-labelledby="actions-title">
            <div class="section-head"><h2 id="actions-title">{{ 'debrief.actions_title'|trans({'%name%': persona.name}) }}</h2></div>
            <ul class="outcomes">
                {% for action in call.actions %}
                    <li>
                        {# When it happened in the call, as the call log counts. #}
                        {% set elapsed = max(0, action.at|date('U') - call.startedAt|date('U')) %}
                        <span class="tag {{ action.tool == 'book_meeting' ? 'good' }}"><time datetime="{{ action.at }}">{{ '%02d:%02d'|format(elapsed // 60, elapsed % 60) }}</time></span>
                        <div><b>{{ ('debrief.action.' ~ action.tool)|trans }}</b>{% if action.summary %} · {{ action.summary }}{% endif %}</div>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
    {% set files = scenario.workspace.sources %}
    {% if files %}
        <section aria-labelledby="files-title">
            <div class="section-head"><h2 id="files-title">{{ 'debrief.files_title'|trans({'%name%': persona.name}) }}</h2></div>
            <p class="small muted section-intro">{{ 'debrief.files_intro'|trans }}</p>
            <div class="stack">
                {% for source in files %}
                    <details class="file">
                        <summary><b>{{ source.label }}</b> <span class="small muted">· {{ 'debrief.records'|trans({'%count%': source.entries|length}) }}{% if source.description %} · {{ source.description }}{% endif %}</span></summary>
                        <div class="stack">
                            {% for entry in source.entries %}
                                <div class="doc small record">
                                    <div class="record-head"><span class="record-kind">{{ entry.when }}</span><span class="record-subject">{{ entry.title }}</span></div>
                                    {% if entry.details %}<dl class="record-fields">{% for detail in entry.details %}<div class="record-field"><dt>{{ detail.name|replace({'_': ' '})|capitalize }}</dt><dd>{{ detail.value }}</dd></div>{% endfor %}</dl>{% endif %}
                                    {% if entry.note %}<p>{{ entry.note }}</p>{% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </details>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endif %}

{% if debrief and call.status.value == 'done' %}
    <div class="halves">
        <section aria-labelledby="best-title">
            <div class="section-head"><h2 id="best-title">{{ 'debrief.best'|trans }}</h2></div>
            <div class="quotes">
                {% for quote in debrief.best %}
                    <div class="quote"><q>{{ quote.quote }}</q><p class="why">{{ quote.why }}</p></div>
                {% else %}<p class="muted">{{ 'debrief.no_best'|trans }}</p>{% endfor %}
            </div>
        </section>
        <section aria-labelledby="worst-title">
            <div class="section-head"><h2 id="worst-title">{{ 'debrief.worst'|trans }}</h2></div>
            <div class="quotes">
                {% for quote in debrief.worst %}
                    <div class="quote">
                        <q>{{ quote.quote }}</q>
                        <p class="why">{{ quote.why }}</p>
                        {% if quote.better %}<p class="better"><b>{{ 'debrief.better'|trans }}</b> <i>{{ quote.better }}</i></p>{% endif %}
                        {% set line = (mine ?? false) ? call.lineOf(quote.quote) : null %}
                        {% if line is not null %}
                            <form method="post" action="{{ path('call_replay', {id: call.id, n: line}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('replay-' ~ call.id) }}">
                                <button class="btn sm"><twig:Icon name="rewind" />{{ 'debrief.replay_moment'|trans }}</button>
                            </form>
                        {% endif %}
                    </div>
                {% else %}<p class="muted">{{ 'debrief.no_worst'|trans }}</p>{% endfor %}
            </div>
        </section>
    </div>
    {% if debrief.tips %}
        <section aria-labelledby="tips-title">
            <div class="section-head"><h2 id="tips-title">{{ 'debrief.tips'|trans }}</h2></div>
            <ol class="numbered measure">{% for tip in debrief.tips %}<li><span>{{ tip }}</span></li>{% endfor %}</ol>
        </section>
    {% endif %}
{% endif %}
</div>
