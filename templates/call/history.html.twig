{# Every call of the member, as a call log. #}
{% extends 'base.html.twig' %}
{% block title %}{{ 'call.history'|trans }}{% endblock %}
{% block body %}
<header class="page-head">
    <div class="page-head-text">
        <a class="eyebrow" href="{{ path('home') }}"><twig:Icon name="arrow-left" size="14" />{{ 'nav.play'|trans }}</a>
        <h1>{{ 'call.history'|trans }}</h1>
    </div>
</header>
{% if calls %}
    {{ include('call/_log.html.twig') }}
{% else %}
    <twig:Empty :title="'play.no_calls'|trans" :text="'play.no_calls_text'|trans">
        <a class="btn primary" href="{{ path('home') }}"><twig:Icon name="phone" />{{ 'play.new_call'|trans }}</a>
    </twig:Empty>
{% endif %}
{% endblock %}
