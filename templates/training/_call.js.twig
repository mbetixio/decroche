// L'appel : on parle au micro (reconnaissance vocale du navigateur), le persona répond à voix haute.
// Pas de chat : un écran de téléphone, l'aperçu de ce qui est compris, et le transcript seulement après.
const $ = (id) => document.getElementById(id);
const screen = $('callscreen'), stateEl = $('state'), sinceEl = $('since'), clock = $('clock'), caption = $('caption'), hint = $('hint');
const keypad = $('keypad'), input = $('input'), keys = $('keys'), pickup = $('pickup'), finish = $('finish'), sheet = $('sheet');
const dots = document.querySelectorAll('#dots i');
const url = {{ path('training_say', {id: t.id})|json_encode|raw }}, token = {{ csrf_token('training' ~ t.id)|json_encode|raw }};
const accent = {{ (s.situation == 'quebec' ? 'fr-CA' : 'fr-FR')|json_encode|raw }};
const who = {{ s.persona.name|split(' ')|first|json_encode|raw }}, personaName = {{ s.persona.name|json_encode|raw }};
const opening = JSON.parse($('last-line').textContent);
const Recognition = window.SpeechRecognition || window.webkitSpeechRecognition;
const pref = (k, d) => { try { return localStorage.getItem('sparring-' + k) ?? d; } catch (e) { return d; } };
const keep = (k, v) => { try { localStorage.setItem('sparring-' + k, v); } catch (e) {} };

let left = {{ t.secondsLeft }}, since = {{ s.minutes * 60 - t.secondsLeft }}, inCall = false, sending = false, over = false;
let muted = false, speaker = pref('speaker', '1') === '1', subs = pref('subs', '0') === '1';

const mmss = (n) => String(Math.floor(n / 60)).padStart(2, '0') + ':' + String(n % 60).padStart(2, '0');
const setState = (state, text) => { screen.dataset.state = state; stateEl.textContent = text; };
const show = (text, cls = '') => { caption.textContent = text; caption.className = 'cs-caption ' + cls; };
const toggleKey = (id, on) => $(id).classList.toggle('on', on);
const setSpeaker = () => { toggleKey('speaker', !speaker); $('speaker').querySelector('i').textContent = speaker ? '🔊' : '🔇'; $('speaker').querySelector('span').textContent = speaker ? 'Son' : 'Son coupé'; };

setInterval(() => {
  clock.textContent = mmss(left);
  clock.parentElement.classList.toggle('late', left <= 60);
  if (inCall && !over) { since++; sinceEl.textContent = mmss(since); left = Math.max(0, left - 1); if (left === 0 && !sending) end('⏰ Le temps est écoulé'); }
}, 1000);
clock.textContent = mmss(left);

// La tonalité de retour d'appel française (440 Hz) le temps que « ça sonne ».
const ringback = (ms) => new Promise((resolve) => {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)(), osc = ctx.createOscillator(), gain = ctx.createGain();
    osc.frequency.value = 440; gain.gain.value = 0.06; osc.connect(gain).connect(ctx.destination); osc.start();
    setTimeout(() => { osc.stop(); ctx.close(); resolve(); }, ms);
  } catch (e) { setTimeout(resolve, ms); }
});

const frenchVoices = () => ('speechSynthesis' in window) ? speechSynthesis.getVoices().filter(v => v.lang && v.lang.toLowerCase().startsWith('fr')) : [];
const natural = (v) => /natural|neural|online|premium|enhanced|am[ée]lior/i.test(v.name);
const HANGING = /(?:^|\s)(et|ou|mais|donc|car|puis|alors|aussi|parce|que|qui|quoi|dont|où|de|du|des|d|le|la|les|l|un|une|au|aux|à|en|dans|sur|pour|par|avec|sans|chez|vers|entre|ce|cet|cette|ces|son|sa|ses|notre|nos|votre|vos|leur|leurs|mon|ma|mes|je|j|tu|il|elle|on|nous|vous|ils|elles|est|sont|suis|sommes|êtes|ai|as|a|avons|avez|ont|c|ça|ce|y|ne|n|pas|plus|très|si|comme|euh|bah|ben|voilà|enfin|genre|aujourd'hui|actuellement|justement|notamment|exemple)$/i;
const pause = (heard, interim) => HANGING.test((heard || '').trim().replace(/[.,!?…]+$/, '')) ? 2000 : (interim.trim() === '' ? 1000 : 1400);
// L'écho : ce que le micro entend ressemble-t-il à ce que le persona est en train de dire ?
const norm = (t) => (t || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9 ]+/g, ' ');
const echo = (text) => {
  const said = ' ' + norm(voice.heardSoFar) + ' ';
  const words = norm(text).split(/\s+/).filter(w => w.length > 2);
  if (!words.length) return true;
  return words.filter(w => said.includes(' ' + w + ' ')).length / words.length >= 0.5;
};
const voice = {
  rec: null, listening: false, startedAt: 0, lastAt: 0, finalText: '', timer: null,
  // La voix la plus naturelle du navigateur, du même genre que le persona :
  // les voix neuronales d'Edge (« Natural », « Online »), les voix Premium/Améliorées de macOS, celles de Google, puis le reste.
  pick() {
    if (this.chosen !== undefined) return this.chosen;
    const all = frenchVoices();
    if (!all.length) return null;
    const forced = all.find(v => v.name === pref('voice-name', ''));
    if (forced) return this.chosen = forced;
    const women = /am[ée]lie|audrey|aur[ée]lie|marie|denise|elo[iï]se|vivienne|brigitte|c[ée]line|julie|hortense|l[ée]a|sylvie|jos[ée]phine|coralie|jacqueline|yolande|virginie|ariane|charline|google fran/i;
    const men = /thomas|daniel|henri|r[ée]my|paul|nicolas|jean|claude|antoine|j[ée]r[ôo]me|fabrice|alain|mathieu|jacques|guillaume|gerard|g[ée]rard|maxime|alain|lucien/i;
    const first = personaName.split(' ')[0].toLowerCase();
    const maleE = /^(pierre|philippe|st[ée]phane|j[ée]r[ôo]me|antoine|maxime|guillaume|alexandre|christophe|[ée]tienne|th[ée]ophile|r[ée]mi|jules|georges|baptiste|g[ée]r[ôo]me|hugues|serge|yves|andr[ée]|bruce|mike|luke|steve)$/;
    const female = /(e|a|ie|ine|elle)$/.test(first) && !maleE.test(first);
    const score = (v) => {
      const n = v.name;
      let s = 0;
      if (/natural|neural|online/i.test(n)) s += 50;
      if (/premium/i.test(n)) s += 45;
      if (/enhanced|am[ée]lior/i.test(n)) s += 35;
      if (/google/i.test(n)) s += 20;
      if (v.lang.replace('_', '-').toLowerCase() === accent.toLowerCase()) s += 10;
      if ((female ? women : men).test(n)) s += 30; else if ((female ? men : women).test(n)) s -= 30;
      if (/compact|eloquence|grandma|grandpa|rocko|shelley|flo|reed|sandy/i.test(n)) s -= 40;
      return s;
    };
    const ranked = all.map(v => [score(v), v]).sort((a, b) => b[0] - a[0]);
    // Parmi les meilleures à égalité, le nom du persona départage : chaque persona garde sa voix.
    const top = ranked.filter(r => r[0] === ranked[0][0]).map(r => r[1]);
    let h = 0; for (const c of personaName) h = (h * 31 + c.charCodeAt(0)) >>> 0;
    this.chosen = top[h % top.length];
    return this.chosen;
  },
  // La réplique est lue d'un seul tenant, pour garder l'intonation d'une vraie phrase. Seules les voix Google de
  // Chrome coupent au bout d'une quinzaine de secondes : pour elles, on lit phrase par phrase.
  // La voix neuronale d'Edge, générée par le serveur ; la voix du navigateur si elle manque ou si on en a choisi une.
  server() { return !!opening.edge && pref('voice-name', '') === ''; },
  play(url) {
    return new Promise((resolve, reject) => {
      const a = new Audio(url); this.audio = a;
      this.stopAudio = () => { a.pause(); this.audio = null; resolve(); };
      a.onended = () => { this.audio = null; resolve(); };
      a.onerror = () => { this.audio = null; reject(new Error('audio')); };
      a.play().catch(reject);
    });
  },
  hush() { this.cut = true; if (this.audio && this.stopAudio) this.stopAudio(); if ('speechSynthesis' in window) { this.interrupted = true; speechSynthesis.cancel(); } },
  async speak(text, audioUrl = null) {
    if (subs || !speaker) show(text, 'them');
    if (!speaker) return;
    this.interrupted = false;
    setState('speaking', who + ' parle…');
    if (audioUrl && this.server()) {
      try { await this.play(audioUrl); return; } catch (e) { /* le service de voix ne répond pas : la voix du navigateur prend le relais */ }
    }
    if (!('speechSynthesis' in window)) return;
    speechSynthesis.cancel();
    const v = this.pick();
    const parts = v && /google/i.test(v.name) ? (text.match(/[^.!?…]+[.!?…]*\s*/g) || [text]) : [text];
    for (const part of parts) {
      if (over && !this.lastWords) break;
      await new Promise((resolve) => {
        const u = new SpeechSynthesisUtterance(part.trim()); u.lang = v ? v.lang : accent; u.rate = 1.12;
        if (v) u.voice = v;
        u.onend = u.onerror = () => resolve();
        speechSynthesis.speak(u);
      });
      if (this.interrupted) { this.interrupted = false; break; }
    }
  },
  // Couper la parole : pendant que le persona répond, le micro reste ouvert. Si le commercial parle vraiment (pas un
  // simple « oui », et pas l'écho de la voix du persona dans le micro), le persona se tait et l'écoute.
  watch() {
    if (!Recognition || muted || over || !inCall || pref('barge', '1') !== '1' || this.watching) return;
    const rec = new Recognition(); this.watchRec = rec; this.watching = true;
    rec.lang = 'fr-FR'; rec.continuous = true; rec.interimResults = true;
    rec.onresult = (e) => {
      let text = '';
      for (let i = 0; i < e.results.length; i++) text += e.results[i][0].transcript + ' ';
      text = text.trim();
      if (text.split(/\s+/).length >= 4 && !echo(text)) this.bargeIn(text);
    };
    rec.onend = () => { this.watching = false; if (sending && !over && !this.barged) setTimeout(() => this.watch(), 150); };
    try { rec.start(); } catch (e) { this.watching = false; }
  },
  unwatch() { this.watching = false; try { this.watchRec && this.watchRec.abort(); } catch (e) {} this.watchRec = null; },
  bargeIn(text) {
    if (this.barged) return;
    this.barged = text; this.unwatch(); this.hush();
    if (this.abortTurn) this.abortTurn();
    show(text, 'me'); setState('talking', 'Vous parlez…');
  },
  listen(seed = '') {
    if (!Recognition || muted || over || sending || this.listening || !inCall) { if (inCall && !sending && !over) setState('waiting', muted ? 'Micro coupé' : 'À vous'); return; }
    this.finalText = seed ? seed + ' ' : ''; this.startedAt = seed ? performance.now() : 0; this.lastAt = this.startedAt;
    const rec = new Recognition(); this.rec = rec;
    rec.lang = 'fr-FR'; rec.continuous = true; rec.interimResults = true;
    rec.onresult = (e) => {
      let interim = '';
      for (let i = e.resultIndex; i < e.results.length; i++) {
        if (e.results[i].isFinal) this.finalText += e.results[i][0].transcript + ' ';
        else interim += e.results[i][0].transcript;
      }
      const now = performance.now(); if (!this.startedAt) this.startedAt = now; this.lastAt = now;
      this.heard = (this.finalText + interim).trim();
      show(this.heard, 'me');
      setState('talking', 'Vous parlez…');
      // La fin de tour : on ne coupe pas une phrase en suspens. Après un mot qui appelle une suite (« et », « de »,
      // « donc », « sont »…), on attend 2 s ; après un segment que la reconnaissance a clos, 1 s ; sinon 1,4 s.
      clearTimeout(this.timer);
      this.timer = setTimeout(() => this.done(), pause(this.heard, interim));
    };
    rec.onerror = (e) => { if (e.error === 'not-allowed' || e.error === 'service-not-allowed') { muted = true; toggleKey('mute', true); show('Le micro est bloqué : autorisez-le dans le navigateur, ou utilisez le clavier.', 'warn'); setState('waiting', 'Micro bloqué'); keypad.hidden = false; toggleKey('kbd', true); } };
    rec.onend = () => { this.listening = false; if (!sending && !over && !muted && inCall && !this.sendingVoice) setTimeout(() => this.listen(), 200); };
    try { rec.start(); this.listening = true; this.heard = seed; if (seed) { show(seed, 'me'); setState('talking', 'Vous parlez…'); this.timer = setTimeout(() => this.done(), 1400); } else setState('listening', 'À vous'); } catch (e) {}
  },
  done() {
    const text = (this.heard || '').trim();
    if (!text) return;
    const ms = Math.round(this.lastAt - this.startedAt) + 600;
    this.sendingVoice = true; clearTimeout(this.timer);
    try { this.rec && this.rec.stop(); } catch (e) {}
    this.listening = false;
    say(text, ms).finally(() => { this.sendingVoice = false; });
  },
  stop() { clearTimeout(this.timer); try { this.rec && this.rec.abort(); } catch (e) {} this.listening = false; },
};

// Une phrase du persona : sa voix neuronale (MP3 venu du flux) ou celle du navigateur ; les sous-titres s'allongent.
const sayPart = async (text, audio) => {
  if (voice.cut) return;
  voice.heardSoFar = (voice.heardSoFar ? voice.heardSoFar + ' ' : '') + text;
  if (subs || !speaker) show(voice.heardSoFar, 'them');
  if (!speaker) return;
  setState('speaking', who + ' parle…');
  if (audio && voice.server()) {
    const bytes = Uint8Array.from(atob(audio), c => c.charCodeAt(0));
    const src = URL.createObjectURL(new Blob([bytes], { type: 'audio/mpeg' }));
    try { await voice.play(src); return; } catch (e) { /* repli sur la voix du navigateur */ } finally { URL.revokeObjectURL(src); }
  }
  if (!('speechSynthesis' in window)) return;
  await new Promise((resolve) => {
    const v = voice.pick(); const u = new SpeechSynthesisUtterance(text); u.lang = v ? v.lang : accent; u.rate = 1.12;
    if (v) u.voice = v;
    u.onend = u.onerror = () => resolve();
    speechSynthesis.speak(u);
  });
};

// Le tour de parole en flux : chaque phrase est dite dès qu'elle arrive, pendant que le persona écrit la suite.
const say = async (text, voiceMs = null) => {
  text = text.trim();
  if (!text || sending || over) return;
  sending = true; voice.stop(); voice.cut = false; voice.heardSoFar = '';
  const interrupted = !!voice.wasCut; voice.wasCut = false;
  const ctrl = new AbortController(); voice.abortTurn = () => ctrl.abort();
  setTimeout(() => { if (sending) voice.watch(); }, 300);
  show(text, 'me sent');
  setState('thinking', '');
  let chain = Promise.resolve(), result = null, first = true;
  try {
    const r = await fetch(url + (voice.server() ? '' : '?browserVoice=1'), { method: 'POST', signal: ctrl.signal, headers: { 'Content-Type': 'application/json', 'Accept': 'application/x-ndjson', 'X-CSRF-Token': token }, body: JSON.stringify({ message: text, voiceMs, interrupted }) });
    if (!r.ok) { const data = await r.json(); show('⚠️ ' + data.error, 'warn'); if (data.ended) end('Appel terminé'); return; }
    const reader = r.body.getReader(), decoder = new TextDecoder();
    let buffer = '';
    for (;;) {
      const { value, done } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      let nl;
      while ((nl = buffer.indexOf('\n')) >= 0) {
        const line = buffer.slice(0, nl).trim(); buffer = buffer.slice(nl + 1);
        if (!line) continue;
        const e = JSON.parse(line);
        if (e.t === 'say') {
          if (first) { first = false; if (!subs && speaker) show('', ''); }
          chain = chain.then(() => sayPart(e.text, e.audio));
        } else if (e.t === 'done') result = e;
        else if (e.t === 'error') chain = chain.then(() => show('⚠️ ' + e.error, 'warn'));
      }
    }
    if (result) { left = result.secondsLeft; dots.forEach((d, i) => d.classList.toggle('on', i < result.revealed)); if (result.ended) voice.lastWords = true; }
    await chain;
    if (result && result.ended) end(result.endedBy === 'persona' ? who + ' a raccroché' : '⏰ Le temps est écoulé');
  } catch (e) { await chain; if (!voice.barged) show('⚠️ La ligne a grésillé, ' + who + ' n\'a rien entendu : répétez.', 'warn'); }
  finally {
    sending = false; voice.abortTurn = null; voice.unwatch();
    const seed = voice.barged || ''; voice.barged = null;
    if (seed) voice.wasCut = true;
    if (!over) setTimeout(() => voice.listen(seed), seed ? 150 : 0);
  }
};

// La fin de l'appel : la ligne coupe, l'analyse part.
const end = (why) => {
  if (over) return;
  over = true; voice.stop();
  setState('ended', why); keys.hidden = true; keypad.hidden = true;
  hint.textContent = 'Analyse de l\'appel…';
  setTimeout(() => { busy.style.display = 'grid'; finish.submit(); }, 1500);
};

const start = async () => {
  pickup.hidden = true; finish.hidden = false;
  if ({{ (sit and sit.direction == 'entrant') ? 'false' : 'true' }} && !opening.resumed) { setState('ringing', 'Ça sonne…'); await ringback(1600); }
  inCall = true; keys.hidden = false; sinceEl.hidden = false; hint.textContent = '';
  const v = voice.pick();
  if (speaker && !voice.server() && 'speechSynthesis' in window && !(v && natural(v))) hint.textContent = 'Voix robotique ? Jouez dans Microsoft Edge : ses voix neuronales sont presque humaines.';
  if (!Recognition) { keypad.hidden = false; toggleKey('kbd', true); hint.textContent = 'Ce navigateur ne reconnaît pas la voix (Chrome, Edge ou Safari) : répondez au clavier.'; }
  if (opening.line) await voice.speak(opening.line, opening.audio);
  voice.listen();
};
pickup.addEventListener('click', start);
// Les voix (surtout celles d'Edge, en ligne) arrivent après le chargement : on refait le choix quand la liste change.
if ('speechSynthesis' in window) { speechSynthesis.getVoices(); speechSynthesis.addEventListener('voiceschanged', () => { voice.chosen = undefined; fillVoices(); }); }

$('mute').addEventListener('click', () => {
  muted = !muted; toggleKey('mute', muted);
  if (muted) { voice.stop(); if (!sending) setState('waiting', 'Micro coupé'); } else voice.listen();
});
$('speaker').addEventListener('click', () => { speaker = !speaker; keep('speaker', speaker ? '1' : '0'); setSpeaker(); if (!speaker) voice.hush(); });
$('subs').addEventListener('click', () => { subs = !subs; keep('subs', subs ? '1' : '0'); toggleKey('subs', subs); });
$('kbd').addEventListener('click', () => { keypad.hidden = !keypad.hidden; toggleKey('kbd', !keypad.hidden); if (!keypad.hidden) input.focus(); });
keypad.addEventListener('submit', (e) => { e.preventDefault(); const v = input.value; input.value = ''; say(v); });
// La fiche reste ouverte à côté de l'appel (sur grand écran) : on garde ses objectifs sous les yeux.
const setSheet = (open) => { sheet.hidden = !open; screen.classList.toggle('with-sheet', open); toggleKey('sheet-open', open); };
$('sheet-open').addEventListener('click', () => setSheet(sheet.hidden));
$('sheet-close').addEventListener('click', () => setSheet(false));
setSheet(window.innerWidth >= 900);
// Couper la parole au persona : un clic sur son avatar, et c'est à vous.
$('avatar').addEventListener('click', () => { if (screen.dataset.state === 'speaking') voice.hush(); });
finish.addEventListener('submit', () => { over = true; voice.stop(); voice.hush(); });
setSpeaker(); toggleKey('subs', subs);
if (opening.resumed) { stateEl.textContent = 'Appel en attente : reprenez la ligne'; }

// Le choix de la voix, dans « Ma fiche » : la meilleure est prise d'office, mais on peut en écouter et en garder une autre.
const voicePick = $('voice-pick'), voiceNote = $('voice-note');
const fillVoices = () => {
  const all = frenchVoices();
  voicePick.innerHTML = '';
  voicePick.add(new Option(opening.edge ? '★ Voix naturelle Microsoft (' + opening.edge.replace(/^fr-..-|Multilingual|Neural$/g, '') + ')' : 'Automatique (la plus naturelle du navigateur)', ''));
  if (opening.edge && pref('voice-name', '') === '') {
    [...all].forEach(v => voicePick.add(new Option('Navigateur : ' + v.name, v.name)));
    voicePick.value = '';
    voiceNote.textContent = 'Voix générée par le serveur, la même sur tous les navigateurs.';
    return;
  }
  if (!all.length) { voiceNote.textContent = 'Ce navigateur ne propose aucune voix française.'; return; }
  const current = voice.pick();
  [...all].sort((a, b) => natural(b) - natural(a) || a.name.localeCompare(b.name)).forEach(v => voicePick.add(new Option('Navigateur : ' + (natural(v) ? '★ ' : '') + v.name, v.name)));
  voicePick.value = pref('voice-name', '');
  const count = all.filter(natural).length;
  voiceNote.textContent = 'Voix utilisée : ' + (current ? current.name : '—') + '. ' + (count ? count + ' voix naturelle(s) ★ disponibles.' : 'Aucune voix naturelle ici : ouvrez Sparring dans Microsoft Edge (Windows ou Mac).');
};
voicePick.addEventListener('change', () => { keep('voice-name', voicePick.value); voice.chosen = undefined; fillVoices(); });
$('voice-test').addEventListener('click', () => { voice.hush(); if (voice.server() && opening.test) { voice.play(opening.test).catch(() => {}); return; } if (!('speechSynthesis' in window)) return; speechSynthesis.cancel(); const v = voice.pick(); const u = new SpeechSynthesisUtterance('Bonjour, ' + personaName + ' à l\'appareil. Je vous écoute.'); if (v) { u.voice = v; u.lang = v.lang; } speechSynthesis.speak(u); });
fillVoices();
console.info('Sparring, voix françaises :', frenchVoices().map(v => v.name));

// Couper la parole : réglage gardé dans le navigateur, actif par défaut.
const bargeToggle = $('barge-toggle');
bargeToggle.checked = pref('barge', '1') === '1';
bargeToggle.addEventListener('change', () => { keep('barge', bargeToggle.checked ? '1' : '0'); if (!bargeToggle.checked) voice.unwatch(); });
