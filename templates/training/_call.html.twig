{# L'écran d'appel : un téléphone, pas un chat. On parle, on écoute, on raccroche. #}
{% set initials = s.persona.name|split(' ')|map(w => w|first)|slice(0, 2)|join|upper %}
{% set incoming = sit and sit.direction == 'entrant' %}
<style>body { overflow: hidden; }</style>
<div class="callscreen" id="callscreen" data-state="idle">
  <div class="cs-top">
    <span class="cs-pill">{{ t.replayOf ? '↺ Reprise · ' : '' }}{{ sit ? sit.emoji ~ ' ' ~ sit.label : s.categoryLabel }}</span>
    <span class="cs-pill" title="Durée du rendez-vous">reste <b id="clock">--:--</b></span>
  </div>

  <div class="cs-who">
    <div class="cs-avatar" id="avatar"><span>{{ initials }}</span></div>
    <h1 class="cs-name">{{ s.persona.name }}</h1>
    <div class="cs-sub">{{ s.persona.role }} · {{ s.persona.company }}</div>
    <div class="cs-status"><span id="since" hidden>00:00</span><span id="state">{{ incoming ? 'Appel entrant…' : 'Prêt à appeler' }}</span></div>
  </div>

  <div class="cs-caption" id="caption" aria-live="polite"></div>

  <form class="cs-keypad" id="keypad" hidden>
    <input id="input" maxlength="2000" autocomplete="off" placeholder="Tapez votre réplique si vous ne pouvez pas parler…">
    <button class="cs-send" aria-label="Envoyer">➤</button>
  </form>

  <div class="cs-controls">
    <div class="cs-keys" id="keys" hidden>
      <button type="button" class="cs-key" id="mute"><i>🎙️</i><span>Micro</span></button>
      <button type="button" class="cs-key" id="speaker"><i>🔊</i><span>Son</span></button>
      <button type="button" class="cs-key" id="subs"><i>💬</i><span>Sous-titres</span></button>
      <button type="button" class="cs-key" id="kbd"><i>⌨️</i><span>Clavier</span></button>
      <button type="button" class="cs-key" id="sheet-open"><i>📋</i><span>Ma fiche</span></button>
    </div>
    <div class="cs-main">
      <button type="button" class="cs-round pickup" id="pickup" aria-label="{{ incoming ? 'Décrocher' : 'Appeler' }}">📞</button>
      <form method="post" action="{{ path('training_finish', {id: t.id}) }}" id="finish" hidden><input type="hidden" name="_token" value="{{ csrf_token('training' ~ t.id) }}"><button class="cs-round hangup" aria-label="Raccrocher">📞</button></form>
    </div>
    <div class="cs-hint" id="hint">{{ incoming ? 'Ça sonne : décrochez.' : 'Appuyez pour lancer l\'appel.' }} Parlez naturellement, comme au téléphone.</div>
  </div>
</div>

<aside class="cs-sheet" id="sheet" hidden>
  <div class="row between" style="margin-bottom:12px"><h2 style="margin:0">Ma fiche</h2><button type="button" class="btn ghost" id="sheet-close">Masquer</button></div>
  <p class="small"><b>Objectif :</b> {{ s.goal }}</p>
  {% if s.objectiveList %}<ol class="objectives small" style="margin-top:10px">{% for o in s.objectiveList %}<li><span class="tag">{{ loop.index }}</span><span>{{ o }}</span></li>{% endfor %}</ol>{% endif %}
  <div class="muted small" style="margin-top:14px">Rubriques du brief découvertes</div>
  <div class="dots" id="dots" style="margin-top:6px">{% for i in 1..(t.briefSheet|length) %}<i class="{{ i <= t.revealed|length ? 'on' }}"></i>{% endfor %}</div>
  <div class="muted small" style="margin-top:14px">La voix de votre interlocuteur</div>
  <div class="row" style="margin-top:6px;flex-wrap:nowrap"><select id="voice-pick" style="flex:1;min-width:0"></select><button type="button" class="btn ghost" id="voice-test" title="Écouter">▶︎ Écouter</button></div>
  <p class="small muted" id="voice-note" style="margin-top:6px"></p>
  <label class="row small" style="margin-top:8px;font-weight:600"><input type="checkbox" id="barge-toggle" style="width:auto"> Pouvoir couper la parole (plus fiable avec un casque)</label>
  <details style="margin-top:14px" open><summary class="small muted">Le contexte</summary><p class="small" style="margin-top:6px">{{ s.context }}</p></details>
  {% if s.material %}<details style="margin-top:10px"><summary class="small muted">{{ sit ? sit.material : 'Le document' }}</summary><div class="doc small" style="margin-top:6px;padding:10px">{{ s.material }}</div></details>{% endif %}
  <form method="post" action="{{ path('training_abandon', {id: t.id}) }}" onsubmit="return confirm('Abandonner cet appel ? Il ne sera pas noté.')" style="margin-top:18px"><input type="hidden" name="_token" value="{{ csrf_token('training' ~ t.id) }}"><button class="btn ghost" style="width:100%;justify-content:center">Abandonner sans analyse</button></form>
</aside>

<script type="application/json" id="last-line">{% set lastPersona = t.messages|length and (t.messages|last).role == 'persona' %}{{ {line: lastPersona ? (t.messages|last).content : null, resumed: t.sellerTurns > 0, audio: (edge and lastPersona) ? path('training_voice', {id: t.id, n: t.messages|length - 1}) : null, edge: edge, test: (edge and t.messages|length) ? path('training_voice', {id: t.id, n: 0}) : null}|json_encode|raw }}</script>
