{# The team board: members and their figures, missions, invitations, results by situation, latest calls. #}
{% extends 'base.html.twig' %}
{% block title %}{{ 'nav.team'|trans }}{% endblock %}
{% block body %}
<header class="page-head">
    <div class="page-head-text"><h1>{{ 'team.title'|trans }}</h1><p class="lead">{{ 'team.lead'|trans }}</p></div>
    <div class="page-actions"><a class="btn primary" href="#invitations"><twig:Icon name="plus" />{{ 'team.invite'|trans }}</a></div>
</header>

<section aria-labelledby="members-title">
    <h2 id="members-title" class="visually-hidden">{{ 'team.members'|trans }}</h2>
    <div class="table-wrap"><table>
        <thead><tr>
            <th scope="col">{{ 'team.member'|trans }}</th><th scope="col">{{ 'progress.difficulty'|trans }}</th><th scope="col" class="num">{{ 'progress.calls'|trans }}</th>
            <th scope="col" class="num">{{ 'progress.average'|trans }}</th><th scope="col" class="num">{{ 'progress.trend'|trans }}</th><th scope="col">{{ 'team.to_work_on'|trans }}</th><th scope="col">{{ 'team.last_call'|trans }}</th>
        </tr></thead>
        <tbody>
            {% for row in board.members %}
                {% set m = row.member %}{% set s = row.stats %}
                <tr>
                    <th scope="row"><a class="member-cell" href="{{ path('team_member', {id: m.id}) }}"><twig:Avatar :initials="m.initials" /><span><b>{{ m.name }}</b><span class="list-sub">{{ m.role|trans }}</span></span></a></th>
                    <td class="nowrap">{{ s.challenge.difficulty|trans }}</td>
                    <td class="num">{{ s.done }}</td>
                    <td class="num"><twig:Score :value="s.average" /></td>
                    <td class="num">{% if s.trend is not null %}<span class="score {{ s.trend >= 0 ? 'good' : 'bad' }}"><span aria-hidden="true">{{ s.trend >= 0 ? '▲' : '▼' }}</span> <span class="visually-hidden">{{ s.trend >= 0 ? '+' : '−' }}</span>{{ s.trend|abs }}</span>{% else %}<span class="faint">—</span>{% endif %}</td>
                    <td class="small">{{ s.weakest ? s.criteria[s.weakest].label : '—' }}</td>
                    <td class="small nowrap">{{ row.lastAt|day }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table></div>
</section>

<div class="halves section spaced">
    <section id="missions" aria-labelledby="missions-title">
        <div class="section-head"><h2 id="missions-title">{{ 'team.missions'|trans }}</h2></div>
        {% if missions %}
            <ul class="list">
                {% for row in missions %}
                    {% set mission = row.mission %}
                    {% set situation = company().situation(mission.situation) %}
                    <li class="list-item">
                        <div class="grow stack stack-s">
                            <p class="list-title">{{ 'play.mission_calls'|trans({'%count%': mission.calls, '%situation%': situation ? situation.label : 'play.any_situation'|trans}) }}</p>
                            <p class="small muted">{{ mission.assignee ? mission.assignee.name : 'form.mission.whole_team'|trans }} · {{ 'play.mission_target'|trans({'%score%': mission.target}) }}{% if mission.dueAt %} · {{ 'play.mission_due'|trans({'%date%': mission.dueAt|day}) }}{% endif %}</p>
                            <p class="progress-list">{% for p in row.members %}<span class="{{ p.done >= mission.calls ? 'done' }}">{{ p.member.name }} <span class="num">{{ p.done }}/{{ mission.calls }}</span>{% if p.done >= mission.calls %} ✓{% endif %}</span>{% endfor %}</p>
                        </div>
                        <form method="post" action="{{ path('team_mission_remove', {id: mission.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('mission-' ~ mission.id) }}"><button class="btn ghost sm icon" aria-label="{{ 'action.remove'|trans }}" title="{{ 'action.remove'|trans }}"><twig:Icon name="trash" /></button></form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        <details class="mt-l" {{ missions ? '' : 'open' }}>
            <summary class="btn sm"><twig:Icon name="plus" />{{ 'team.new_mission'|trans }}</summary>
            {{ form_start(missionForm, {attr: {class: 'form mt-l'}}) }}
                <div class="fields-2">{{ form_row(missionForm.assignee) }}{{ form_row(missionForm.situation) }}</div>
                <div class="fields-3">{{ form_row(missionForm.calls) }}{{ form_row(missionForm.target) }}{{ form_row(missionForm.dueAt) }}</div>
                {{ form_row(missionForm.note) }}
                <div class="form-actions"><button class="btn">{{ 'team.give_mission'|trans }}</button></div>
            {{ form_end(missionForm) }}
        </details>
    </section>
    <section id="invitations" aria-labelledby="invitations-title">
        <div class="section-head"><h2 id="invitations-title">{{ 'team.invitations'|trans }}</h2></div>
        {% if invitations %}<div class="stack">{{ include('team/_invitations.html.twig') }}</div>{% endif %}
        {{ form_start(inviteForm, {attr: {class: 'form' ~ (invitations ? ' mt-l' : '')}}) }}
            {{ form_rest(inviteForm) }}
            <div class="form-actions"><button class="btn">{{ 'team.create_links'|trans }}</button></div>
        {{ form_end(inviteForm) }}
    </section>
</div>

<div class="halves section spaced">
    <section aria-labelledby="by-situation-title">
        <div class="section-head"><h2 id="by-situation-title">{{ 'progress.by_situation'|trans }}</h2></div>
        {% if board.situations %}
            <div class="table-wrap"><table>
                <thead><tr><th scope="col">{{ 'progress.situation'|trans }}</th><th scope="col" class="num">{{ 'progress.calls'|trans }}</th><th scope="col" class="num">{{ 'progress.average'|trans }}</th></tr></thead>
                <tbody>{% for row in board.situations %}<tr><td>{{ row.label }}</td><td class="num">{{ row.calls }}</td><td class="num"><twig:Score :value="row.average" /></td></tr>{% endfor %}</tbody>
            </table></div>
        {% else %}<twig:Empty :title="'progress.no_scores'|trans" />{% endif %}
    </section>
    <section aria-labelledby="latest-title">
        <div class="section-head"><h2 id="latest-title">{{ 'team.latest'|trans }}</h2></div>
        {% if board.recent %}
            {{ include('call/_log.html.twig', {calls: board.recent, who: true}) }}
        {% else %}<twig:Empty :title="'play.no_calls'|trans" />{% endif %}
    </section>
</div>
{% endblock %}
