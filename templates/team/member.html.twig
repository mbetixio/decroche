{# One member's figures, for their managers, with their role and a new password if needed. #}
{% extends 'base.html.twig' %}
{% block title %}{{ member.name }}{% endblock %}
{% block body %}
<header class="page-head">
    <div class="page-head-text">
        <a class="eyebrow" href="{{ path('team') }}"><twig:Icon name="arrow-left" size="14" />{{ 'nav.team'|trans }}</a>
        <div class="person-head">
            <twig:Avatar :initials="member.initials" size="lg" />
            <div><h1>{{ member.name }}</h1><p class="muted">{{ member.email }} · {{ member.role|trans }}</p></div>
        </div>
    </div>
    {% if member != app.user %}
        <div class="page-actions">
            <form method="post" action="{{ path('team_role', {id: member.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('role-' ~ member.id) }}"><button class="btn">{{ (member.isManager ? 'team.make_seller' : 'team.make_manager')|trans }}</button></form>
            <form method="post" action="{{ path('team_password', {id: member.id}) }}" data-controller="confirm" data-action="confirm#ask" data-confirm-message-value="{{ 'team.reset_confirm'|trans }}"><input type="hidden" name="_token" value="{{ csrf_token('password-' ~ member.id) }}"><button class="btn ghost"><twig:Icon name="key" />{{ 'team.reset_password'|trans }}</button></form>
        </div>
    {% endif %}
</header>
{% if password is defined %}
    <div class="notice warn mt-l" role="status">
        <twig:Icon name="key" />
        <div class="grow stack stack-s">
            <p><b>{{ 'team.new_password'|trans }}</b> {{ 'team.new_password_help'|trans }}</p>
            <div class="copy-field" data-controller="copy"><input readonly value="{{ password }}" data-copy-target="source" aria-label="{{ 'team.new_password'|trans }}"><button type="button" class="btn sm" data-action="copy#copy"><twig:Icon name="copy" /><span data-copy-target="label">{{ 'action.copy'|trans }}</span></button></div>
        </div>
    </div>
{% endif %}
{% if member.profile or missions %}
    <div class="halves section-gap">
        {% if member.profile %}
            <section aria-labelledby="profile-title">
                <h2 id="profile-title" class="label">{{ 'team.profile'|trans }}</h2>
                <p class="pre muted">{{ member.profile }}</p>
            </section>
        {% endif %}
        {% if missions %}
            <section aria-labelledby="member-missions-title">
                <h2 id="member-missions-title" class="label">{{ 'team.missions'|trans }}</h2>
                <ul class="progress-list">
                    {% for row in missions %}<li class="{{ row.done >= row.mission.calls ? 'done' }}"><span class="num">{{ row.done }}/{{ row.mission.calls }}</span> · {{ row.mission.situation ? (company().situation(row.mission.situation).label ?? '') : 'play.any_situation'|trans }}</li>{% endfor %}
                </ul>
            </section>
        {% endif %}
    </div>
{% endif %}
{{ include('progress/_stats.html.twig', {mine: false}) }}
{% endblock %}
