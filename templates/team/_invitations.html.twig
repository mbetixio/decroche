{# Pending invitations with their link to copy (and to withdraw, on the team page). #}
<ul class="list">
    {% for invitation in invitations %}
        <li class="list-item">
            <div class="grow stack stack-s">
                <p><b>{{ invitation.email }}</b> <span class="faint small">· {{ invitation.role|trans }}</span></p>
                <div class="copy-field" data-controller="copy">
                    <input readonly value="{{ url('join', {token: invitation.token}) }}" data-copy-target="source" aria-label="{{ 'team.invitation_link'|trans({'%email%': invitation.email}) }}">
                    <button type="button" class="btn sm" data-action="copy#copy"><twig:Icon name="copy" /><span data-copy-target="label">{{ 'action.copy'|trans }}</span></button>
                </div>
            </div>
            {% if withdraw ?? true %}
                <form method="post" action="{{ path('team_invitation_withdraw', {id: invitation.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('withdraw-' ~ invitation.id) }}"><button class="btn ghost sm icon" aria-label="{{ 'action.withdraw'|trans }} · {{ invitation.email }}" title="{{ 'action.withdraw'|trans }}"><twig:Icon name="trash" /></button></form>
            {% endif %}
        </li>
    {% endfor %}
</ul>
