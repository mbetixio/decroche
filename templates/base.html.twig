{# The page skeleton. Signed-in members of a set-up instance get the app shell (sidebar, or a bottom bar on phones);
   the onboarding, the sign-in and the call screen fill the whole page through the "page" block. #}
<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#14161b" media="(prefers-color-scheme: dark)">
    {# The page's own title (already escaped by its block), then the product's name. #}
    {% set page_title = block('title') is defined and block('title')|trim != '' ? block('title')|trim ~ ' · Practicall' : 'Practicall' %}
    <title>{{ page_title|raw }}</title>
    <meta name="description" content="{{ 'meta.description'|trans }}">
    {# An instance holds a company's private calls: search engines stay out, links still get a rich preview. #}
    <meta name="robots" content="noindex, nofollow">
    <meta name="application-name" content="Practicall">
    <meta name="apple-mobile-web-app-title" content="Practicall">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Practicall">
    <meta property="og:title" content="{{ page_title|raw }}">
    <meta property="og:description" content="{{ 'meta.description'|trans }}">
    <meta property="og:image" content="{{ app.request.schemeAndHttpHost }}/brand/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="{{ app.request.locale == 'fr' ? 'fr_FR' : 'en_US' }}">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" type="image/svg+xml" href="/brand/logo.svg">
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body>
<a class="skip-link" href="#main">{{ 'meta.skip'|trans }}</a>
{% block page %}
<div class="shell">
    {% set route = app.request.attributes.get('_route') %}
    <aside class="sidebar">
        <a class="brand" href="{{ path('home') }}">
            <img class="brand-logo" src="/brand/logo.svg" alt="" width="34" height="34">
            <span>Practicall<small>{{ company().name }}</small></span>
        </a>
        {# On phones the sidebar becomes a bottom bar: the secondary links ("desktop-only") are reached from their pages,
           and the account takes the last place. #}
        <nav class="nav" aria-label="{{ 'nav.main'|trans }}">
            <a href="{{ path('home') }}" {{ route in ['home', 'call_briefing', 'call_show', 'call_history'] ? 'aria-current="page"' }}><twig:Icon name="phone" /><span>{{ 'nav.play'|trans }}</span></a>
            <a href="{{ path('library') }}" {{ route == 'library' or route starts with 'scenario' ? 'aria-current="page"' }}><twig:Icon name="book" /><span class="long">{{ 'nav.library'|trans }}</span><span class="short" aria-hidden="true">{{ 'nav.library_short'|trans }}</span></a>
            <a href="{{ path('prepare') }}" class="desktop-only" {{ route == 'prepare' ? 'aria-current="page"' }}><twig:Icon name="wand" /><span>{{ 'nav.prepare'|trans }}</span></a>
            <a href="{{ path('progress') }}" {{ route == 'progress' ? 'aria-current="page"' }}><twig:Icon name="chart" /><span class="long">{{ 'nav.progress'|trans }}</span><span class="short" aria-hidden="true">{{ 'nav.progress_short'|trans }}</span></a>
            <a href="{{ path('offer') }}" class="desktop-only" {{ route == 'offer' ? 'aria-current="page"' }}><twig:Icon name="file" /><span>{{ 'nav.offer'|trans }}</span></a>
            {% if is_granted('ROLE_MANAGER') %}
                <span class="nav-label" aria-hidden="true">{{ 'nav.manage'|trans }}</span>
                <a href="{{ path('team') }}" {{ route starts with 'team' ? 'aria-current="page"' }}><twig:Icon name="users" /><span>{{ 'nav.team'|trans }}</span></a>
                <a href="{{ path('settings') }}" class="desktop-only" {{ route starts with 'settings' ? 'aria-current="page"' }}><twig:Icon name="building" /><span>{{ 'nav.company'|trans }}</span></a>
            {% endif %}
            <a href="{{ path('account') }}" class="phone-only" {{ route in ['account', 'profile'] ? 'aria-current="page"' }}><twig:Icon name="user" /><span class="long">{{ 'nav.account'|trans }}</span><span class="short" aria-hidden="true">{{ 'nav.account_short'|trans }}</span></a>
        </nav>
        <div class="sidebar-foot">
            <a class="me" href="{{ path('account') }}" {{ route in ['account', 'profile'] ? 'aria-current="page"' }}>
                <twig:Avatar :initials="app.user.initials" :name="app.user.name" />
                <span class="grow"><span class="me-name">{{ app.user.name }}</span><span class="me-role">{{ app.user.role|trans }}</span></span>
            </a>
            <a class="btn ghost sm" href="{{ logout_path() }}"><twig:Icon name="logout" />{{ 'nav.logout'|trans }}</a>
            {% if source_url %}<a class="source-link" href="{{ source_url }}" rel="noopener">{{ 'meta.source'|trans }}</a>{% endif %}
        </div>
    </aside>
    <main class="main" id="main">
        {{ include('_flashes.html.twig') }}
        {% block body %}{% endblock %}
    </main>
</div>
{% endblock %}
</body>
</html>
