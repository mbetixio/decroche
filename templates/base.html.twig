{# The page skeleton. Signed-in members of a set-up instance get the app shell (sidebar, or a bottom bar on phones);
   the onboarding, the sign-in and the call screen fill the whole page through the "page" block. #}
<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}Practicall{% endblock %} · {{ company().name ?: 'Practicall' }}</title>
    <link rel="icon" type="image/svg+xml" href="/brand/logo.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Inter+Tight:wght@700;800&display=swap" rel="stylesheet">
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body>
{% block page %}
<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="{{ path('home') }}">
            <img class="brand-logo" src="/brand/logo.svg" alt="" width="38" height="38">
            <span>Practicall<small>{{ company().name }}</small></span>
        </a>
        {% set route = app.request.attributes.get('_route') %}
        <nav class="nav" aria-label="{{ 'nav.main'|trans }}">
            <a href="{{ path('home') }}" {{ route in ['home', 'call_briefing', 'call_show'] ? 'aria-current="page"' }}><twig:Icon name="phone" /><span>{{ 'nav.play'|trans }}</span></a>
            <a href="{{ path('library') }}" {{ route starts with 'library' or route starts with 'scenario' ? 'aria-current="page"' }}><twig:Icon name="book" /><span>{{ 'nav.library'|trans }}</span></a>
            <a href="{{ path('prepare') }}" class="secondary" {{ route == 'prepare' ? 'aria-current="page"' }}><twig:Icon name="wand" /><span>{{ 'nav.prepare'|trans }}</span></a>
            <a href="{{ path('progress') }}" {{ route == 'progress' ? 'aria-current="page"' }}><twig:Icon name="chart" /><span>{{ 'nav.progress'|trans }}</span></a>
            <a href="{{ path('offer') }}" class="secondary" {{ route == 'offer' ? 'aria-current="page"' }}><twig:Icon name="file" /><span>{{ 'nav.offer'|trans }}</span></a>
            {% if is_granted('ROLE_MANAGER') %}
                <span class="nav-label">{{ 'nav.manage'|trans }}</span>
                <a href="{{ path('team') }}" {{ route starts with 'team' ? 'aria-current="page"' }}><twig:Icon name="users" /><span>{{ 'nav.team'|trans }}</span></a>
                <a href="{{ path('settings') }}" class="secondary" {{ route starts with 'settings' ? 'aria-current="page"' }}><twig:Icon name="building" /><span>{{ 'nav.company'|trans }}</span></a>
            {% endif %}
        </nav>
        <div class="sidebar-foot">
            <a class="me" href="{{ path('account') }}">
                <twig:Avatar :initials="app.user.initials" :name="app.user.name" />
                <span><b>{{ app.user.name }}</b><span>{{ app.user.role|trans }}</span></span>
            </a>
            <a class="btn ghost sm" href="{{ path('logout') }}"><twig:Icon name="logout" />{{ 'nav.logout'|trans }}</a>
        </div>
    </aside>
    <main class="main" id="main">
        {{ include('_flashes.html.twig') }}
        {% block body %}{% endblock %}
    </main>
</div>
{% endblock %}
</body>
</html>
