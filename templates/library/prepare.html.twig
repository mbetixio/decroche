{# Rehearsing a real meeting: a prospect sheet, or a past call's transcript, turned into a practice call. #}
{% extends 'base.html.twig' %}
{% block title %}{{ 'nav.prepare'|trans }}{% endblock %}
{% block body %}
<header class="page-head">
    <div class="page-head-text">
        <h1>{{ 'prepare.title'|trans }}</h1>
        <p class="lead">{{ 'prepare.lead'|trans }}</p>
    </div>
</header>
<div class="split">
    {{ form_start(form, {attr: {class: 'form', 'data-controller': 'busy', 'data-action': 'busy#start', 'data-busy-overlay-value': 'draw-overlay'}}) }}
        {{ form_row(form.fromCall) }}
        {{ form_row(form.text) }}
        <div class="fields-3">{{ form_row(form.type) }}{{ form_row(form.difficulty) }}{{ form_row(form.minutes) }}</div>
        <div class="form-actions"><button class="btn primary lg"><twig:Icon name="wand" />{{ 'prepare.submit'|trans }}</button></div>
    {{ form_end(form) }}
    <aside class="stack" aria-labelledby="how-title">
        <h2 id="how-title" class="label">{{ 'prepare.how_title'|trans }}</h2>
        <p class="small muted">{{ 'prepare.how'|trans }}</p>
        <p class="small muted">{{ 'prepare.mcp'|trans }}</p>
    </aside>
</div>
{{ include('play/_draw_overlay.html.twig') }}
{% endblock %}
