{# The member's account: profile, password, their MCP address, and signing out (the only way to it on phones). #}
{% extends 'base.html.twig' %}
{% block title %}{{ 'account.title'|trans }}{% endblock %}
{% block body %}
<header class="page-head">
    <div class="page-head-text">
        <div class="person-head">
            <twig:Avatar :initials="app.user.initials" size="lg" />
            <div><h1>{{ app.user.name }}</h1><p class="muted">{{ app.user.email }} · {{ app.user.role|trans }}</p></div>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn" href="{{ path('profile') }}"><twig:Icon name="user" />{{ 'account.edit_profile'|trans }}</a>
        <a class="btn ghost" href="{{ logout_path() }}"><twig:Icon name="logout" />{{ 'nav.logout'|trans }}</a>
    </div>
</header>
<div class="halves">
    <section aria-labelledby="mcp-title">
        <div class="section-head"><h2 id="mcp-title">{{ 'account.mcp_title'|trans }}</h2></div>
        <div class="stack">
            <p class="muted">{{ 'account.mcp_lead'|trans }}</p>
            {% if key %}
                <div class="field" data-controller="copy">
                    <label for="mcp-url">{{ 'account.mcp_url'|trans }}</label>
                    <div class="copy-field"><input id="mcp-url" readonly value="{{ url('_mcp_endpoint_practicall') }}?key={{ key }}" data-copy-target="source" aria-describedby="mcp-once"><button type="button" class="btn sm" data-action="copy#copy"><twig:Icon name="copy" /><span data-copy-target="label">{{ 'action.copy'|trans }}</span></button></div>
                    <p class="help text-warn" id="mcp-once">{{ 'account.mcp_once'|trans }}</p>
                </div>
            {% endif %}
            <form method="post" action="{{ path('account_mcp_key') }}" {% if app.user.mcpKeyHash %}data-controller="confirm" data-action="confirm#ask" data-confirm-message-value="{{ 'account.mcp_replace_confirm'|trans }}"{% endif %}>
                <input type="hidden" name="_token" value="{{ csrf_token('mcp-key') }}">
                <button class="btn {{ key or app.user.mcpKeyHash ? '' : 'primary' }}"><twig:Icon name="key" />{{ (app.user.mcpKeyHash ? 'account.mcp_new' : 'account.mcp_create')|trans }}</button>
            </form>
            <details>
                <summary class="small muted">{{ 'account.mcp_how'|trans }}</summary>
                <ol class="numbered small mt-l">
                    <li><span>{{ 'account.mcp_step1'|trans }}</span></li>
                    <li><span>{{ 'account.mcp_step2'|trans }}</span></li>
                    <li><span>{{ 'account.mcp_step3'|trans }}</span></li>
                </ol>
            </details>
        </div>
    </section>
    <section aria-labelledby="password-title">
        <div class="section-head"><h2 id="password-title">{{ 'account.password'|trans }}</h2></div>
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_rest(form) }}
            <div class="form-actions"><button class="btn">{{ 'account.change_password'|trans }}</button></div>
        {{ form_end(form) }}
    </section>
</div>
{% if is_granted('ROLE_MANAGER') %}
    <p class="small muted section spaced phone-links"><a href="{{ path('settings') }}">{{ 'nav.company'|trans }}</a> · <a href="{{ path('offer') }}">{{ 'nav.offer'|trans }}</a> · <a href="{{ path('prepare') }}">{{ 'nav.prepare'|trans }}</a></p>
{% else %}
    <p class="small muted section spaced phone-links"><a href="{{ path('offer') }}">{{ 'nav.offer'|trans }}</a> · <a href="{{ path('prepare') }}">{{ 'nav.prepare'|trans }}</a></p>
{% endif %}
{% endblock %}
