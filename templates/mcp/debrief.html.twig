{# L'app MCP du débrief : le thème, et JSON-RPC avec l'hôte (Claude, ChatGPT…) par postMessage. Elle demande sa vue à
   l'outil debrief_view, pour la session que l'outil debrief a reçue (la dernière par défaut). #}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Débrief Sparring</title>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" onload="this.rel='stylesheet'">
<style>
{% include '_style.css.twig' %}
body { background: var(--bg); padding: 8px; border-radius: 14px; }
.loading { padding: 40px; text-align: center; color: var(--muted); }
#app.busy { opacity: .7; }
</style>
</head>
<body>
<div id="app"><p class="loading">Rédaction du débrief…</p></div>
<script>
const root = document.getElementById('app');
let nextId = 0, session = 0, shown = false;
const pending = new Map();
const post = (msg) => window.parent.postMessage(msg, '*');
const rpc = (method, params) => new Promise((resolve, reject) => { const id = ++nextId; pending.set(id, { resolve, reject }); post({ jsonrpc: '2.0', id, method, params }); });
const notify = (method, params) => post({ jsonrpc: '2.0', method, params });
const reportSize = () => notify('ui/notifications/size-changed', { width: document.documentElement.scrollWidth, height: document.documentElement.scrollHeight });
new ResizeObserver(reportSize).observe(document.body);
const say = (text) => { const p = document.createElement('p'); p.className = 'loading'; p.textContent = text; root.replaceChildren(p); reportSize(); };
const refresh = async () => {
  root.classList.add('busy');
  try {
    const result = await rpc('tools/call', { name: 'debrief_view', arguments: session ? { session } : {} });
    const html = result?.structuredContent?.html;
    if (html) { root.innerHTML = html; shown = true; reportSize(); }
    else say('⚠️ ' + (result?.content?.[0]?.text ?? 'Le débrief est introuvable.'));
  } catch (e) { say('⚠️ Le débrief n\'a pas pu être chargé.'); }
  finally { root.classList.remove('busy'); }
};
window.addEventListener('message', (event) => {
  let msg = event.data;
  if (typeof msg === 'string') { try { msg = JSON.parse(msg); } catch { return; } }
  if (!msg || typeof msg !== 'object') return;
  if (msg.id !== undefined && pending.has(msg.id)) { const { resolve, reject } = pending.get(msg.id); pending.delete(msg.id); msg.error ? reject(msg.error) : resolve(msg.result); }
  else if (msg.method === 'ui/notifications/tool-input') { session = parseInt(msg.params?.arguments?.session ?? 0, 10) || 0; }
  else if (msg.method === 'ui/notifications/tool-result') { const s = msg.params?.structuredContent?.session; if (s) session = s; refresh(); }
});
(async () => {
  try { await rpc('ui/initialize', { appInfo: { name: 'Sparring', version: '1.0.0' }, appCapabilities: {}, protocolVersion: '2026-01-26' }); notify('ui/notifications/initialized', {}); } catch (e) {}
  setTimeout(() => { if (!shown) refresh(); }, 400);
})();
</script>
</body>
</html>
