# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
APP_ENV=dev
APP_SECRET=change-me-in-env-local
APP_SHARE_DIR=var/share
# Le fuseau des dates affichées.
APP_TIMEZONE=Europe/Paris
DEFAULT_URI=http://127.0.0.1:8300
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
MCP_STATE_KEY=change-me-change-me-change-me-change-me

# Le modèle qui joue les interlocuteurs et rédige les débriefs : toute API compatible OpenAI (voir App\Ai\Brain).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# En-têtes supplémentaires, en JSON (OpenCode Go : {"x-opencode-session": "sparring"}).
AI_HEADERS={}

# Un tunnel ou un proxy inverse de confiance (hôte et schéma transmis), par ex. 127.0.0.1,::1.
TRUSTED_PROXIES=

# Les noms d'hôte sur lesquels le serveur MCP répond : ajoutez votre domaine public ou votre tunnel.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
