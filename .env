# Practicall's default configuration. Put your own values (your model key, your secrets) in .env.local, which is never
# committed. In production, real environment variables override everything here.
# https://symfony.com/doc/current/configuration.html#configuring-environment-variables-in-env-files

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-env-local
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# Dates and times are shown in this time zone.
APP_TIMEZONE=Europe/Paris

# The public address of the instance: used for links generated outside a request (MCP call links, invitations).
DEFAULT_URI=http://127.0.0.1:8000

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

# The language model that plays the personas and writes the debriefs: any OpenAI-compatible API.
# Hugging Face Inference Providers by default (gpt-oss-120b, fast on the phone); put your token in .env.local as
# AI_API_KEY=hf_…. For OpenAI: AI_BASE_URL=https://api.openai.com/v1, AI_MODEL=gpt-5.4-mini.
AI_BASE_URL=https://router.huggingface.co/v1
AI_COMPLETIONS_PATH=/chat/completions
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
# Extra HTTP headers for the model's API, as a JSON object.
AI_HEADERS={}

# The MCP server: the key that seals its request state, and the host names it answers on (add your public domain).
MCP_STATE_KEY=change-me-change-me-change-me-change-me
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# A trusted reverse proxy in front of Practicall (its forwarded host and scheme are believed), e.g. private_ranges.
TRUSTED_PROXIES=

# Optional paths, with their defaults (the Docker image sets them to its volume):
# EDGE_TTS=var/edge-tts/bin/edge-tts          the edge-tts binary that voices the personas (without it, the browser speaks)
# VOICES_DIR=var/voices                       the persona lines already synthesized, as MP3
# SESSION_SAVE_PATH=var/sessions/prod         where sessions are kept in production

# Where the source code of this instance can be found: Practicall is AGPL-3.0, so its users may get it (a link at the
# foot of every page). Point it at your fork if you modify it.
SOURCE_URL=https://github.com/mbetixio/practicall
